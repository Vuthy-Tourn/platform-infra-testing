/**
 * Microservices Orchestrator Pipeline
 *
 * Improvements over previous version:
 *   1. mergeEnvAndRelationships — temp file is now unique per service (index-scoped)
 *      to eliminate write-race when called from parallel branches.
 *   2. resolveRelationshipsToken — same fix: index-scoped temp files.
 *   3. failures list — writes are now synchronized so parallel build branches
 *      cannot corrupt the list with concurrent appends.
 *   4. platform-infra is stashed after 'Checkout infra' — no re-checkout needed in GitOps stage.
 *   5. resolveCommitAndFramework runs in parallel across all services in 'Prepare release plan'.
 *   6. 'Build and push services' triggers all child jobs in parallel.
 *   7. gitops-batch uses fetch+reset when the directory already exists (preserves cache).
 */
pipeline {
    agent { label 'master' }

    options {
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        string(name: 'USER_ID',                   defaultValue: '', description: 'Tenant user ID')
        string(name: 'WORKSPACE_ID',              defaultValue: '', description: 'Workspace ID / slug')
        string(name: 'PROJECT_NAME',              defaultValue: 'workspace-stack', description: 'Workspace-level stack name written to GitOps')
        string(name: 'PLATFORM_DOMAIN',           defaultValue: 'autonomous-istad.com', description: 'Wildcard platform domain')
        string(name: 'GITOPS_BRANCH',             defaultValue: 'main', description: 'GitOps branch to update')
        string(name: 'SERVICE_JOB_NAME',          defaultValue: 'deploy-service-test', description: 'Jenkins job name used to deploy one service')
        string(name: 'SONARQUBE_SERVER_NAME',     defaultValue: 'sonarqube', description: 'Jenkins SonarQube server configuration name')
        string(name: 'SONARQUBE_SCANNER_TOOL',    defaultValue: '', description: 'Optional Jenkins SonarScanner tool name; empty uses sonar-scanner from PATH')
        string(name: 'SONARQUBE_JDK_TOOL_PREFIX', defaultValue: 'jdk', description: 'Jenkins JDK tool name prefix used for Java SonarQube analysis (example: jdk -> jdk21)')
        booleanParam(name: 'ENABLE_GITOPS_UPDATE',        defaultValue: true,  description: 'Update GitOps repository once after all service builds succeed')
        booleanParam(name: 'ENABLE_SONARQUBE_SCAN',       defaultValue: false, description: 'Run SonarQube source analysis for each changed service')
        booleanParam(name: 'ENABLE_SONARQUBE_QUALITY_GATE', defaultValue: false, description: 'Wait for SonarQube quality gate before continuing each service build')
        booleanParam(name: 'ROLLBACK_MODE',               defaultValue: false, description: 'Rollback all services to saved image tags')
        booleanParam(name: 'GITOPS_ONLY_UPDATE',          defaultValue: false, description: 'Skip service builds and update GitOps only using the provided image tags')
        booleanParam(name: 'DESTROY_MODE',                defaultValue: false, description: 'Remove this microservice project from GitOps and tear down its runtime resources')
        string(name: 'SERVICES_JSON',             defaultValue: '[]', description: 'JSON array of service descriptors')
        string(name: 'CHANGED_SERVICES',          defaultValue: '', description: 'Optional comma-separated service names to rebuild during webhook-triggered updates')
    }

    environment {
        INFRA_REPO_URL      = credentials('infra-repo-url-micro')
        REGISTRY_REPOSITORY = credentials('register-url-micro')
        GITOPS_REPO_URL     = credentials('gitops-repo-url-micro')
    }

    stages {

        // ──────────────────────────────────────────────────────────────────────
        stage('Validate') {
            steps {
                script {
                    if (!params.USER_ID?.trim()) {
                        error('USER_ID is required')
                    }
                    if (!params.SERVICES_JSON?.trim() || params.SERVICES_JSON.trim() == '[]') {
                        error('SERVICES_JSON is required and must not be empty')
                    }

                    def services
                    try {
                        services = parseJson(params.SERVICES_JSON)
                    } catch (Exception e) {
                        error("SERVICES_JSON is not valid JSON: ${e.message}")
                    }

                    if (!(services instanceof List) || services.isEmpty()) {
                        error('SERVICES_JSON must be a non-empty JSON array')
                    }

                    services.each { svc ->
                        if (!svc.name?.toString()?.trim()) {
                            error("Service entry missing 'name': ${svc}")
                        }
                        if (!params.ROLLBACK_MODE && !params.DESTROY_MODE && !params.GITOPS_ONLY_UPDATE && !svc.repoUrl?.toString()?.trim()) {
                            error("Service '${svc.name}' missing 'repoUrl'")
                        }
                        if ((params.ROLLBACK_MODE || params.GITOPS_ONLY_UPDATE) && !params.DESTROY_MODE && !svc.imageTag?.toString()?.trim()) {
                            error("Service '${svc.name}' missing 'imageTag' for rollback/GitOps-only update")
                        }
                        if ((params.ROLLBACK_MODE || params.GITOPS_ONLY_UPDATE) && !params.DESTROY_MODE && !svc.framework?.toString()?.trim()) {
                            error("Service '${svc.name}' missing 'framework' for rollback/GitOps-only update")
                        }
                    }

                    env.EFFECTIVE_WORKSPACE_ID = params.WORKSPACE_ID?.trim() ?: params.USER_ID.trim()
                    env.SAFE_USER_ID           = slugify(params.USER_ID, 30)
                    env.SAFE_WORKSPACE_ID      = slugify(env.EFFECTIVE_WORKSPACE_ID, 30)
                    env.SAFE_STACK_NAME        = slugify(params.PROJECT_NAME?.trim() ?: 'workspace-stack', 40)

                    def registryContext = resolveRegistryContext(env.REGISTRY_REPOSITORY ?: '')
                    env.NORMALIZED_REGISTRY_REPOSITORY = registryContext.repositoryRoot
                    env.REGISTRY_LOGIN_SERVER          = registryContext.loginServer

                    echo "Validated ${services.size()} service(s) for workspace ${env.EFFECTIVE_WORKSPACE_ID}"
                    echo "Workspace stack name    : ${env.SAFE_STACK_NAME}"
                    echo "Deployment namespace    : ${env.SAFE_WORKSPACE_ID}"
                    echo "Downstream service job  : ${params.SERVICE_JOB_NAME}"
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Checkout infra') {
            steps {
                dir('platform-infra') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: env.INFRA_REPO_URL,
                            credentialsId: 'infra-repo-creds'
                        ]]
                    ])
                }
                script {
                    env.INFRA_SCRIPTS_DIR = sh(
                        script: '''
                            set -e
                            for d in "$WORKSPACE/platform-infra/jenkins/scripts" "$WORKSPACE/plateform-infra/jenkins/scripts"; do
                                if [ -f "$d/detect-framework.sh" ]; then echo "$d"; exit 0; fi
                            done
                            echo "ERROR: infra Jenkins scripts directory not found." >&2
                            exit 1
                        ''',
                        returnStdout: true
                    ).trim()
                }
                // Stash once — reused in GitOps stage without re-checkout
                stash name: 'platform-infra-src', includes: 'platform-infra/**'
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Resolve deploy order') {
            steps {
                script {
                    def services = parseJson(params.SERVICES_JSON)
                    def ordered  = topologicalSort(services)
                    env.ORDERED_SERVICE_NAMES  = ordered.collect { it.name }.join(',')
                    env.ORDERED_SERVICES_STATE = encodeServicesForState(ordered)
                    echo "Deploy order: ${env.ORDERED_SERVICE_NAMES}"
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Prepare release plan') {
            when {
                expression { return !params.DESTROY_MODE }
            }
            steps {
                script {
                    def services         = decodeServicesFromState(env.ORDERED_SERVICES_STATE)
                    def syncWaveByService = buildSyncWaveMap(services)

                    // Resolve commit SHA + framework for all services IN PARALLEL.
                    // Each branch writes to its own map key — no shared-state conflict.
                    // Temp files inside resolveCommitAndFramework use the service index
                    // for uniqueness so concurrent calls never collide.
                    def resolvedMetadata = [:]
                    if (!params.ROLLBACK_MODE && !params.GITOPS_ONLY_UPDATE) {
                        def parallelClones = [:]
                        services.eachWithIndex { svc, index ->
                            def frameworkOverride = svc.framework?.toString()?.trim() ?: ''
                            def branch            = svc.branch?.toString()?.trim() ?: 'main'
                            def safeProjectName   = slugify(svc.name.toString().trim(), 40)
                            def capturedSvc       = svc
                            def capturedIndex     = index
                            def capturedName      = svc.name.toString().trim()

                            parallelClones["resolve-${safeProjectName}"] = {
                                def metadata = resolveCommitAndFramework(
                                    capturedSvc, branch, safeProjectName, capturedIndex, frameworkOverride
                                )
                                resolvedMetadata[capturedName] = metadata
                            }
                        }
                        parallel parallelClones
                    }

                    def plannedServices = []
                    services.eachWithIndex { svc, index ->
                        def serviceName     = svc.name.toString().trim()
                        def safeProjectName = slugify(serviceName, 40)
                        def imageRepository = buildImageRepository(
                            env.NORMALIZED_REGISTRY_REPOSITORY, safeProjectName, env.SAFE_USER_ID
                        )

                        def branch            = svc.branch?.toString()?.trim() ?: 'main'
                        def frameworkOverride = svc.framework?.toString()?.trim() ?: ''
                        def metadata          = (params.ROLLBACK_MODE || params.GITOPS_ONLY_UPDATE)
                            ? [
                                commitSha: params.ROLLBACK_MODE
                                    ? "rollback-${svc.imageTag.toString().trim()}"
                                    : "gitops-${svc.imageTag.toString().trim()}",
                                framework: frameworkOverride,
                                branch   : branch
                            ]
                            : resolvedMetadata[serviceName]

                        def commitSha     = metadata.commitSha
                        def framework     = metadata.framework
                        def resolvedBranch = metadata.branch ?: branch
                        def imageTag      = svc.imageTag?.toString()?.trim()
                            ? svc.imageTag.toString().trim()
                            : "${env.BUILD_NUMBER}-${commitSha}"

                        // Pass index so the helper can create unique temp files
                        def relationshipsToken = resolveRelationshipsToken(
                            svc, services, env.EFFECTIVE_WORKSPACE_ID, env.SAFE_STACK_NAME, index
                        )

                        plannedServices << [
                            name                : serviceName,
                            repoUrl             : svc.repoUrl?.toString()?.trim() ?: '',
                            branch              : resolvedBranch,
                            repoCredentialsId   : svc.repoCredentialsId?.toString()?.trim() ?: '',
                            framework           : framework,
                            appPort             : svc.appPort?.toString()?.trim() ?: '8080',
                            imageTag            : imageTag,
                            envJson             : svc.envJson?.toString()?.trim() ?: '[]',
                            relationshipsToken  : relationshipsToken,
                            dependsOn           : svc.dependsOn ?: [],
                            serviceType         : svc.serviceType?.toString()?.trim() ?: 'internal',
                            exposePublic : svc.exposePublic?.toString()?.toBoolean(),
                            primaryPublic: svc.primaryPublic?.toString()?.toBoolean(),
                            servicePath  : svc.servicePath?.toString()?.trim() ?: '.',
                            serviceModule: svc.serviceModule?.toString()?.trim() ?: '',
                            // Pass index so mergeEnvAndRelationships temp file is unique per service
                            mergedEnvJson       : mergeEnvAndRelationships(
                                svc.envJson?.toString()?.trim() ?: '[]',
                                relationshipsToken,
                                index
                            ),
                            imageRepository     : imageRepository,
                            commitSha           : commitSha,
                            customDomain        : svc.customDomain?.toString()?.trim() ?: '',
                            platformHostOverride: svc.platformHostOverride?.toString()?.trim() ?: '',
                            syncWave            : (syncWaveByService[serviceName] ?: 0).toString()
                        ]
                    }

                    env.PLANNED_SERVICES_STATE = encodeServicesForState(plannedServices)
                    echo "Prepared release plan for ${plannedServices.size()} service(s)"
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Build and push services') {
            when {
                expression { return !params.DESTROY_MODE && !params.ROLLBACK_MODE && !params.GITOPS_ONLY_UPDATE }
            }
            agent { label 'istad' }
            steps {
                script {
                    def services           = decodeServicesFromState(env.PLANNED_SERVICES_STATE)
                    def changedServiceNames = parseServiceSelection(params.CHANGED_SERVICES)
                    def selectiveBuild     = !params.ROLLBACK_MODE && !params.DESTROY_MODE && !changedServiceNames.isEmpty()

                    if (selectiveBuild) {
                        echo "Selective rebuild enabled for: ${changedServiceNames.join(', ')}"
                    }

                    def parallelBuilds = [:]
                    // Synchronized list — parallel branches append results concurrently.
                    def failures = Collections.synchronizedList([])

                    services.each { svc ->
                        if (selectiveBuild && !changedServiceNames.contains(svc.name?.toString()?.trim())) {
                            echo "=== Skipping unchanged service: ${svc.name} ==="
                            return
                        }

                        def capturedSvc = svc
                        parallelBuilds["build-${capturedSvc.name}"] = {
                            echo "=== Building: ${capturedSvc.name} (type: ${capturedSvc.serviceType}) ==="
                            try {
                                def downstreamBuild = build job: params.SERVICE_JOB_NAME,
                                    wait     : true,
                                    propagate: false,
                                    parameters: [
                                        string(name: 'REPO_URL', value: capturedSvc.repoUrl),
                                        string(name: 'BRANCH', value: capturedSvc.branch),
                                        string(name: 'USER_ID', value: params.USER_ID),
                                        string(name: 'WORKSPACE_ID', value: env.EFFECTIVE_WORKSPACE_ID),
                                        string(name: 'PROJECT_NAME', value: capturedSvc.name),
                                        string(name: 'SERVICE_NAME', value: capturedSvc.name),
                                        string(name: 'SERVICE_PATH', value: capturedSvc.servicePath ?: capturedSvc.name),
                                        string(name: 'FRAMEWORK', value: capturedSvc.framework),
                                        string(name: 'IMAGE_TAG', value: capturedSvc.imageTag),
                                        string(name: 'REPO_CREDENTIALS_ID', value: capturedSvc.repoCredentialsId),
                                        string(name: 'SONARQUBE_SERVER_NAME', value: params.SONARQUBE_SERVER_NAME),
                                        string(name: 'SONARQUBE_SCANNER_TOOL', value: params.SONARQUBE_SCANNER_TOOL),
                                        string(name: 'SONARQUBE_JDK_TOOL_PREFIX', value: params.SONARQUBE_JDK_TOOL_PREFIX),
                                        booleanParam(name: 'ENABLE_SONARQUBE_SCAN', value: params.ENABLE_SONARQUBE_SCAN),
                                        booleanParam(name: 'ENABLE_SONARQUBE_QUALITY_GATE', value: params.ENABLE_SONARQUBE_QUALITY_GATE),
                                        booleanParam(name: 'ROLLBACK_MODE', value: params.ROLLBACK_MODE)
                                    ]

                                def childNumber = downstreamBuild?.number?.toString() ?: 'unknown'
                                def childResult = downstreamBuild?.result?.toString()?.trim() ?: 'UNKNOWN'
                                def childUrl    = downstreamBuild?.absoluteUrl?.toString()?.trim() ?: ''
                                def urlSuffix   = childUrl ? " · ${childUrl}" : ''

                                echo "[service:${capturedSvc.name}] Child build #${childNumber} → ${childResult}${urlSuffix}"

                                if (childResult != 'SUCCESS') {
                                    failures << [name: capturedSvc.name, result: childResult, build: childNumber, url: childUrl]
                                    echo "=== ${capturedSvc.name}: FAILED (${childResult}) ==="
                                } else {
                                    echo "=== ${capturedSvc.name}: SUCCESS ==="
                                }
                            } catch (Exception e) {
                                echo "=== ${capturedSvc.name}: EXCEPTION — ${e.message} ==="
                                failures << [name: capturedSvc.name, result: 'ERROR', build: 'unknown', url: '', detail: e.message]
                            }
                        }
                    }

                    parallel parallelBuilds

                    if (failures) {
                        failures.each { f ->
                            def urlSuffix    = f.url    ? " · ${f.url}"    : ''
                            def detailSuffix = f.detail ? " · ${f.detail}" : ''
                            echo "[FAILURE] ${f.name} — result=${f.result} build=#${f.build}${urlSuffix}${detailSuffix}"
                        }
                        error("Services failed: ${failures.collect { it.name }.join(', ')}")
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Update GitOps repository (batched)') {
            when {
                expression {
                    return params.ENABLE_GITOPS_UPDATE ||
                        params.DESTROY_MODE ||
                        params.ROLLBACK_MODE ||
                        params.GITOPS_ONLY_UPDATE
                }
            }
            steps {
                script {
                    // Restore infra from stash — no re-checkout needed
                    unstash 'platform-infra-src'
                }

                script {
                    def services = params.DESTROY_MODE
                        ? parseJson(params.SERVICES_JSON)
                        : decodeServicesFromState(env.PLANNED_SERVICES_STATE)

                    def operation = params.DESTROY_MODE
                        ? 'destroy'
                        : (params.ROLLBACK_MODE ? 'rollback' : (params.GITOPS_ONLY_UPDATE ? 'config-update' : 'deploy'))

                    if (params.ROLLBACK_MODE) {
                        echo "Rollback mode: updating GitOps to saved image tags only."
                    } else if (params.GITOPS_ONLY_UPDATE) {
                        echo "GitOps-only update mode: skipping child build jobs."
                    }

                    def workspaceCommitMessage =
                        "${operation}(workspace/${env.SAFE_WORKSPACE_ID}/${env.SAFE_USER_ID}/${env.SAFE_STACK_NAME}): ${services.size()} service(s) build=${env.BUILD_NUMBER}"

                    def destroyCleanupCommitMessage =
                        "destroy-cleanup(workspace/${env.SAFE_WORKSPACE_ID}/${env.SAFE_USER_ID}/${env.SAFE_STACK_NAME}): build=${env.BUILD_NUMBER}"

                    def workspaceServicesJson = params.DESTROY_MODE
                        ? params.SERVICES_JSON.trim()
                        : servicesStateToJson(env.PLANNED_SERVICES_STATE)

                    withCredentials([usernamePassword(
                        credentialsId: 'gitops-micro-creds',
                        usernameVariable: 'GITOPS_USERNAME',
                        passwordVariable: 'GITOPS_TOKEN'
                    )]) {
                        sh '''
                            set -e

                            test -f "$WORKSPACE/platform-infra/jenkins/scripts/update-gitops.sh"

                            AUTHED_GITOPS_REPO_URL="${GITOPS_REPO_URL}"
                            case "$AUTHED_GITOPS_REPO_URL" in
                            https://*)
                                AUTHED_GITOPS_REPO_URL="$(printf '%s' "$AUTHED_GITOPS_REPO_URL" | sed "s#^https://#https://${GITOPS_USERNAME}:${GITOPS_TOKEN}@#")"
                                ;;
                            http://*)
                                AUTHED_GITOPS_REPO_URL="$(printf '%s' "$AUTHED_GITOPS_REPO_URL" | sed "s#^http://#http://${GITOPS_USERNAME}:${GITOPS_TOKEN}@#")"
                                ;;
                            esac

                            if [ -d "$WORKSPACE/gitops-batch/.git" ]; then
                                git -C "$WORKSPACE/gitops-batch" remote set-url origin "${AUTHED_GITOPS_REPO_URL}"
                                git -C "$WORKSPACE/gitops-batch" fetch --depth 1 origin "${GITOPS_BRANCH}" >/dev/null
                                git -C "$WORKSPACE/gitops-batch" checkout -f "${GITOPS_BRANCH}" >/dev/null
                                git -C "$WORKSPACE/gitops-batch" reset --hard "origin/${GITOPS_BRANCH}" >/dev/null
                                git -C "$WORKSPACE/gitops-batch" clean -fd >/dev/null
                            else
                                rm -rf "$WORKSPACE/gitops-batch"
                                git clone --branch "${GITOPS_BRANCH}" --depth 1 "${AUTHED_GITOPS_REPO_URL}" "$WORKSPACE/gitops-batch" >/dev/null
                            fi

                            git -C "$WORKSPACE/gitops-batch" config user.email "jenkins@platform.local"
                            git -C "$WORKSPACE/gitops-batch" config user.name "${GITOPS_USERNAME}"
                            git -C "$WORKSPACE/gitops-batch" remote set-url origin "${AUTHED_GITOPS_REPO_URL}"
                        '''

                        if (params.DESTROY_MODE) {
                            withEnv([
                                "DESTROY_APPLICATION_NAME=${slugify("${env.SAFE_STACK_NAME}-${env.SAFE_USER_ID}", 55)}",
                                "DESTROY_APP_ROOT=apps/${env.SAFE_WORKSPACE_ID}/${env.SAFE_USER_ID}/${env.SAFE_STACK_NAME}",
                                "DESTROY_APPLICATION_FILE=applications/${env.SAFE_WORKSPACE_ID}/${env.SAFE_USER_ID}/${env.SAFE_STACK_NAME}.yaml",
                                "DESTROY_CLEANUP_COMMIT_MESSAGE=${destroyCleanupCommitMessage}"
                            ]) {
                                withCredentials([
                                    string(credentialsId: 'argocd-server-url', variable: 'ARGOCD_SERVER'),
                                    usernamePassword(
                                        credentialsId: 'argocd-creds',
                                        usernameVariable: 'ARGOCD_USERNAME',
                                        passwordVariable: 'ARGOCD_PASSWORD'
                                    )
                                ]) {
                                    sh '''
                                        set -e

                                        echo "==== STEP 1: CLEAN GITOPS FIRST ===="
                                        cd "$WORKSPACE/gitops-batch"
                                        echo "DESTROY_APP_ROOT=${DESTROY_APP_ROOT}"
                                        echo "DESTROY_APPLICATION_FILE=${DESTROY_APPLICATION_FILE}"
                                        ls -la "${DESTROY_APP_ROOT}" || echo "App root not found"
                                        ls -la "${DESTROY_APPLICATION_FILE}" || echo "App file not found"
                                        rm -rf "${DESTROY_APP_ROOT}"
                                        rm -f  "${DESTROY_APPLICATION_FILE}"
                                        git add -A
                                        if git diff --cached --quiet; then
                                            echo "No GitOps cleanup changes required."
                                        else
                                            git commit -m "${DESTROY_CLEANUP_COMMIT_MESSAGE}" >/dev/null
                                            git push origin "${GITOPS_BRANCH}" >/dev/null
                                            echo "GitOps cleanup pushed."
                                        fi

                                        echo "Waiting for ArgoCD to sync removal..."
                                        sleep 10

                                        echo "==== STEP 2: LOGIN TO ARGOCD ===="
                                        LOGIN_RESPONSE=$(printf '{"username":"%s","password":"%s"}' \
                                            "${ARGOCD_USERNAME}" "${ARGOCD_PASSWORD}" | \
                                            curl -sS --insecure -X POST \
                                                -H "Content-Type: application/json" \
                                                -d @- \
                                                "https://${ARGOCD_SERVER}/api/v1/session")
                                        ARGOCD_AUTH_TOKEN=$(printf '%s' "$LOGIN_RESPONSE" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("token",""))')
                                        if [ -z "$ARGOCD_AUTH_TOKEN" ]; then
                                            echo "ERROR: ArgoCD login failed. Response: ${LOGIN_RESPONSE}"
                                            exit 1
                                        fi
                                        echo "Token obtained."

                                        echo "==== STEP 3: DELETE ARGOCD APP ===="
                                        DELETE_CODE=$(curl -sS -o /tmp/argocd-delete-response.txt -w "%{http_code}" \
                                            --insecure -X DELETE \
                                            -H "Authorization: Bearer ${ARGOCD_AUTH_TOKEN}" \
                                            -H "Content-Type: application/json" \
                                            "https://${ARGOCD_SERVER}/api/v1/applications/${DESTROY_APPLICATION_NAME}?cascade=true&propagationPolicy=foreground&appNamespace=argocd")
                                        echo "Delete HTTP code: ${DELETE_CODE}"
                                        cat /tmp/argocd-delete-response.txt || true
                                        rm -f /tmp/argocd-delete-response.txt
                                        if [ "$DELETE_CODE" != "200" ] && [ "$DELETE_CODE" != "202" ] && \
                                           [ "$DELETE_CODE" != "204" ] && [ "$DELETE_CODE" != "404" ]; then
                                            echo "ERROR: Failed to delete ArgoCD application."
                                            exit 1
                                        fi

                                        echo "==== STEP 4: WAIT FOR DELETION ===="
                                        DEADLINE=$(( $(date +%s) + 300 ))
                                        while true; do
                                            HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
                                                --insecure \
                                                -H "Authorization: Bearer ${ARGOCD_AUTH_TOKEN}" \
                                                "https://${ARGOCD_SERVER}/api/v1/applications/${DESTROY_APPLICATION_NAME}?appNamespace=argocd")
                                            if [ "$HTTP_CODE" = "404" ] || [ "$HTTP_CODE" = "403" ]; then
                                                echo "Application confirmed deleted."
                                                break
                                            fi
                                            if [ $(date +%s) -gt $DEADLINE ]; then
                                                echo "ERROR: Timed out waiting for ArgoCD deletion."
                                                exit 1
                                            fi
                                            echo "HTTP ${HTTP_CODE} — still deleting, retrying in 10s..."
                                            sleep 10
                                        done

                                        echo "==== DESTROY COMPLETE ===="
                                    '''
                                }
                            }
                        } else {
                            withEnv([
                                "BATCH_OPERATION=${operation}",
                                "BATCH_PROJECT_NAME=${env.SAFE_STACK_NAME}",
                                "BATCH_SERVICES_JSON=${workspaceServicesJson}"
                            ]) {
                                sh '''
                                    set -e
                                    bash "$WORKSPACE/platform-infra/jenkins/scripts/update-gitops.sh" \
                                        --gitops-repo     "${GITOPS_REPO_URL}" \
                                        --gitops-branch   "${GITOPS_BRANCH}" \
                                        --gitops-workdir  "$WORKSPACE/gitops-batch" \
                                        --infra-repo      "${INFRA_REPO_URL}" \
                                        --infra-revision  "main" \
                                        --chart-path      "helm/app-template" \
                                        --operation       "${BATCH_OPERATION}" \
                                        --workspace-id    "${EFFECTIVE_WORKSPACE_ID}" \
                                        --user-id         "${USER_ID}" \
                                        --project-name    "${BATCH_PROJECT_NAME}" \
                                        --services-json   "${BATCH_SERVICES_JSON}" \
                                        --platform-domain "${PLATFORM_DOMAIN}" \
                                        --commit-sha      "workspace-${BUILD_NUMBER}" \
                                        --build-number    "${BUILD_NUMBER}" \
                                        --skip-push       true
                                '''
                            }

                            withEnv(["BATCH_COMMIT_MESSAGE=${workspaceCommitMessage}"]) {
                                sh '''
                                    set -e
                                    cd "$WORKSPACE/gitops-batch"
                                    git add apps applications templates
                                    if git diff --cached --quiet; then
                                        echo "No batched GitOps changes required."
                                        exit 0
                                    fi
                                    git commit -m "${BATCH_COMMIT_MESSAGE}" >/dev/null
                                    git push origin "${GITOPS_BRANCH}" >/dev/null
                                    echo "GitOps changes pushed."
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (params.DESTROY_MODE) {
                    echo "Destroy completed for workspace ${env.EFFECTIVE_WORKSPACE_ID}"
                } else {
                    echo "All services processed for workspace ${env.EFFECTIVE_WORKSPACE_ID}"
                }
            }
        }
        failure {
            script {
                echo params.DESTROY_MODE
                    ? "Destroy failed. Check orchestrator logs."
                    : "One or more services failed. Check orchestrator logs."
            }
        }
        always {
            script {
                echo 'Workspace kept on disk for Git and build-cache reuse.'
                sh 'find "$WORKSPACE/service-plan" -maxdepth 3 -name ".gradle-home" -type d -exec rm -rf {} + 2>/dev/null || true'
                sh 'find "$WORKSPACE/service-plan" -maxdepth 3 -name ".gradle"      -type d -exec rm -rf {} + 2>/dev/null || true'
            }
        }
    }
}

