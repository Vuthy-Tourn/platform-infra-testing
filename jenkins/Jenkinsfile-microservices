// index parameter makes temp files unique — safe to call from parallel branches
def resolveRelationshipsToken(def svc, List services, String workspaceId, String stackName, int index = 0) {
    def servicesTempFile      = ".jenkins-relationships-services-${index}.tsv"
    def directRelsTempFile    = ".jenkins-relationships-direct-${index}.tsv"
    def normalizeField        = { value ->
        String.valueOf(value ?: '').replace('\r', ' ').replace('\n', ' ').replace('\t', ' ').trim()
    }

    def serviceLines = services.collect { c ->
        def logicalName = normalizeField(c.name)
        def runtimeName = buildRuntimeServiceName(stackName, logicalName)
        "${logicalName}\t${normalizeField(runtimeName)}\t${normalizeField(c.appPort)}"
    }
    writeFile file: servicesTempFile, text: serviceLines.join('\n')

    def relationshipsToken  = String.valueOf(svc?.relationshipsToken ?: '').trim()
    def directRelLines      = []
    if (!relationshipsToken) {
        def rawRels = svc?.relationships
        if (rawRels instanceof List) {
            rawRels.each { item ->
                if (item instanceof Map) {
                    def n = normalizeField(item.name)
                    def v = normalizeField(item.value)
                    if (n && v) { directRelLines << "${n}\t${v}" }
                }
            }
        }
    }
    writeFile file: directRelsTempFile, text: directRelLines.join('\n')

    try {
        return sh(
            script: """python3 - '${servicesTempFile}' '${directRelsTempFile}' '${workspaceId ?: ''}' '${relationshipsToken}' <<'PY'
import base64, json, sys

with open(sys.argv[1], 'r', encoding='utf-8') as h:
    service_lines = h.read().splitlines()
with open(sys.argv[2], 'r', encoding='utf-8') as h:
    relationship_lines = h.read().splitlines()

workspace_id        = (sys.argv[3] or '').strip()
relationships_token = (sys.argv[4] or '').strip()

def load_relationships(token, lines):
    if token:
        try:
            decoded = json.loads(base64.b64decode(token).decode("utf-8"))
            return decoded if isinstance(decoded, list) else []
        except Exception:
            return []
    result = []
    for line in lines:
        parts = line.split("\\t", 1)
        name  = parts[0].strip() if len(parts) > 0 else ""
        value = parts[1].strip() if len(parts) > 1 else ""
        if name and value:
            result.append({"name": name, "value": value})
    return result

def parse_port(raw):
    text = str(raw or "").strip()
    if not text: return ""
    try:
        v = int(text)
        return str(v) if v > 0 else ""
    except Exception:
        return ""

service_index = {}
for line in service_lines:
    parts = line.split("\\t")
    name  = parts[0].strip() if len(parts) > 0 else ""
    rname = parts[1].strip() if len(parts) > 1 else ""
    port  = parts[2].strip() if len(parts) > 2 else ""
    if not name: continue
    service_index[name] = {"runtime_name": rname or name, "port": parse_port(port)}

def build_internal_url(target_name, rel_name):
    target = service_index.get(target_name)
    if not target: return target_name
    host = target.get("runtime_name") or target_name
    if workspace_id:
        host = f"{target.get('runtime_name') or target_name}.{workspace_id}.svc"
    port = target.get("port") or ""
    base = f"http://{host}" + (f":{port}" if port else "")
    if rel_name.upper() == "EUREKA_URL":
        return base.rstrip("/") + "/eureka/"
    return base.rstrip("/") + "/"

resolved = []
for item in load_relationships(relationships_token, relationship_lines):
    if not isinstance(item, dict): continue
    name  = str(item.get("name") or "").strip()
    if not name or name.lower() == "depends_on": continue
    value = str(item.get("value") or "").strip()
    if not value: continue
    if value.startswith("http://") or value.startswith("https://"):
        resolved.append({"name": name, "value": value})
    else:
        resolved.append({"name": name, "value": build_internal_url(value, name)})

print(base64.b64encode(json.dumps(resolved, separators=(",", ":")).encode("utf-8")).decode("ascii"))
PY""",
            returnStdout: true
        ).trim()
    } finally {
        sh "rm -f '${servicesTempFile}' '${directRelsTempFile}'"
    }
}

