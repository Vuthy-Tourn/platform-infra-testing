    services.collect { svc ->
        [
            svc.name,
            svc.repoUrl,
            svc.branch,
            svc.repoCredentialsId,
            svc.framework,
            svc.appPort,
            svc.imageTag,
            svc.envJson,
            svc.serviceType,
            svc.customDomain,
            svc.platformHostOverride,
            svc.imageRepository,
            svc.commitSha,
            svc.mergedEnvJson,
            svc.runtimeConfigFileName,
            svc.runtimeConfigFileContent ? Base64.getEncoder().encodeToString(svc.runtimeConfigFileContent.bytes) : '',
            svc.servicePath ?: '.',
            svc.serviceModule ?: '',
            ((svc.dependsOn ?: []).collect { it?.toString() ?: '' }.findAll { it }.join('\u001f')),
            svc.relationshipsToken,
            svc.syncWave,
            (svc.exposePublic  ? 'true' : 'false'),
