def decodeServicesFromState(String state) {
    if (!state?.trim()) { return [] }
    state.readLines().findAll { it?.trim() }.collect { line ->
        def c = line.split('\t', -1).collect { decodeStateField(it) }
        [
            name                : c.size() > 0  ? c[0]  : '',
            repoUrl             : c.size() > 1  ? c[1]  : '',
            branch              : c.size() > 2  ? c[2]  : '',
            repoCredentialsId   : c.size() > 3  ? c[3]  : '',
            framework           : c.size() > 4  ? c[4]  : '',
            appPort             : c.size() > 5  ? c[5]  : '',
            imageTag            : c.size() > 6  ? c[6]  : '',
            envJson             : c.size() > 7  ? c[7]  : '',
            serviceType         : c.size() > 8  ? c[8]  : '',
            customDomain        : c.size() > 9  ? c[9]  : '',
            platformHostOverride: c.size() > 10 ? c[10] : '',
            imageRepository     : c.size() > 11 ? c[11] : '',
            commitSha           : c.size() > 12 ? c[12] : '',
            mergedEnvJson       : c.size() > 13 ? c[13] : '',
            runtimeConfigFileName: c.size() > 14 ? c[14] : '',
            runtimeConfigFileContent: c.size() > 15 && c[15] ? new String(Base64.getDecoder().decode(c[15]), 'UTF-8') : '',
            servicePath  : c.size() > 16 && c[16] ? c[16] : '.',
            serviceModule: c.size() > 17 ? c[17] : '',
            dependsOn    : (c.size() > 18 && c[18]) ? c[18].split('\u001f').findAll { it } : [],
            relationshipsToken: c.size() > 19 ? c[19] : '',
            syncWave     : c.size() > 20 ? c[20] : '0',
            exposePublic : c.size() > 21 ? c[21].toBoolean() : false,
            primaryPublic: c.size() > 22 ? c[22].toBoolean() : false
        ]
    }
}

def encodeStateField(def value) {
    (value?.toString() ?: '')
        .replace('\\', '\\\\')
        .replace('\t', '\\t')
        .replace('\n', '\\n')
        .replace('\r', '\\r')
}

def decodeStateField(String value) {
    (value ?: '')
        .replace('\\r', '\r')
        .replace('\\n', '\n')
        .replace('\\t', '\t')
        .replace('\\\\', '\\')
}

def slugify(String raw, int maxLen = 40) {
    def normalized = (raw ?: '')
        .toLowerCase()
        .replaceAll(/[^a-z0-9-]+/, '-')
        .replaceAll(/^-+/, '')
        .replaceAll(/-+$/, '')
        .replaceAll(/-{2,}/, '-')
    if (!normalized) { normalized = 'x' }
    normalized.take(maxLen)
}

def buildRuntimeServiceName(String stackName, String serviceName) {
    slugify("${slugify(stackName ?: '', 40)}-${slugify(serviceName ?: '', 40)}", 63)
}

def resolveRegistryContext(String rawValue) {
    def normalizedRegistry = (rawValue ?: '')
        .trim()
        .replaceFirst(/^https?:\/\//, '')
        .replaceAll(/\/+$/, '')

    if (!normalizedRegistry) {
        error('REGISTRY_REPOSITORY is required')
    }
    def parts = normalizedRegistry.tokenize('/')
    if (parts.size() < 2) {
        error('REGISTRY_REPOSITORY must include registry host and project, e.g. "harbor.example.com/platform"')
    }
    [loginServer: parts[0], repositoryRoot: normalizedRegistry]
}

