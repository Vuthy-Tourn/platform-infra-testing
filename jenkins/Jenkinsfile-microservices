            "serviceType": c[3] or "internal", "customDomain": c[4],
            "platformHostOverride": c[5], "imageRepository": c[6],
            "imageTag": c[7], "envJson": c[8] or "[]",
            "runtimeConfigFileName": c[9],
            "runtimeConfigFileContent": base64.b64decode(c[10]).decode("utf-8") if c[10] else "",
            "syncWave": c[11] or "0",
            "exposePublic":  c[12].lower() == "true",
            "primaryPublic": c[13].lower() == "true",
        })
print(json.dumps(services, separators=(",", ":")))
PY""",
            returnStdout: true
        ).trim()
    } finally {
        sh "rm -f '${tempFile}'"
    }
}

