    writeFile file: tempFile, text: services.collect { svc ->
        [
            svc.name ?: '',
            svc.framework ?: '',
            svc.appPort ?: '',
            svc.serviceType ?: '',
            svc.customDomain ?: '',
            svc.platformHostOverride ?: '',
            svc.imageRepository ?: '',
            svc.imageTag ?: '',
            svc.mergedEnvJson ?: '[]',
            svc.runtimeConfigFileName ?: '',
            svc.runtimeConfigFileContent ? Base64.getEncoder().encodeToString(svc.runtimeConfigFileContent.bytes) : '',
            svc.syncWave ?: '0',
            (svc.exposePublic  ? 'true' : 'false'),
            (svc.primaryPublic ? 'true' : 'false')
        ].collect { v -> (v?.toString() ?: '').replace('\t', ' ').replace('\n', ' ').replace('\r', ' ') }.join('\t')
