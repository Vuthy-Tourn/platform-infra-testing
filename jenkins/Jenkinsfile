@Library(['share_lib@master', 'a8s-sonarqube@main']) _

pipeline {
    // agent { label 'istad' }
    // agent {
    //     label 'built-in'
    // }
    agent none

    options {
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    parameters {
        string(name: 'REPO_URL',                  defaultValue: '', description: 'Git repository URL from user (GitHub/GitLab)')
        string(name: 'SOURCE_PROVIDER',           defaultValue: 'github', description: 'Source provider or mode (github, gitlab, upload)')
        string(name: 'BRANCH',                    defaultValue: 'main', description: 'Git branch to build')
        string(name: 'BACKEND_SOURCE_ARCHIVE_BASE_URL', defaultValue: '', description: 'Internal backend endpoint used to download uploaded source archives')
        string(name: 'BACKEND_SOURCE_ARCHIVE_TOKEN',    defaultValue: '', description: 'Internal backend token used to download uploaded source archives')
        string(name: 'BACKEND_CALLBACK_URL',            defaultValue: '', description: 'Internal backend base URL for Jenkins callbacks and secret fetches')
        string(name: 'BACKEND_CALLBACK_TOKEN',          defaultValue: '', description: 'Optional direct callback token when no Jenkins callback credential id is used')
        string(name: 'BACKEND_CALLBACK_CREDENTIALS_ID', defaultValue: '', description: 'Optional Jenkins secret text credential id for the backend callback token')
        string(name: 'USER_ID',                   defaultValue: '', description: 'Tenant user id')
        string(name: 'WORKSPACE_ID',              defaultValue: '', description: 'Workspace id/slug for GitOps path partitioning and Kubernetes namespace')
        string(name: 'PROJECT_NAME',              defaultValue: '', description: 'Project slug')
        string(name: 'SERVICE_NAME',              defaultValue: '', description: 'Microservice name')
        string(name: 'SERVICE_PATH',              defaultValue: '.', description: 'Path to service inside repo. Use . for multi-repo')
        string(name: 'SERVICE_MODULE',            defaultValue: '', description: 'Optional Gradle module path for multi-module builds')
        string(name: 'APP_NAME',                  defaultValue: '', description: 'Legacy alias for PROJECT_NAME')
        string(name: 'IMAGE_TAG',                 defaultValue: '', description: 'Optional image tag provided by backend (deploy or rollback)')
        string(name: 'FRAMEWORK',                 defaultValue: '', description: 'Optional framework override provided by backend')
        string(name: 'REPO_CREDENTIALS_ID',       defaultValue: '', description: 'Optional Jenkins credential id for private user repositories')
        string(name: 'SONARQUBE_SERVER_NAME',     defaultValue: 'sonarqube', description: 'Jenkins SonarQube server configuration name')
        string(name: 'SONARQUBE_SCANNER_TOOL',    defaultValue: '', description: 'Optional Jenkins SonarScanner tool name; empty uses sonar-scanner from PATH')
        string(name: 'SONARQUBE_JDK_TOOL_PREFIX', defaultValue: 'jdk', description: 'Jenkins JDK tool name prefix used for Java SonarQube analysis (example: jdk -> jdk21)')
        booleanParam(name: 'ENABLE_SONARQUBE_SCAN',         defaultValue: true, description: 'Run SonarQube source analysis')
        booleanParam(name: 'ENABLE_SONARQUBE_QUALITY_GATE', defaultValue: true, description: 'Wait for SonarQube quality gate before build')
        booleanParam(name: 'ENABLE_TRIVY_SCAN',             defaultValue: true,  description: 'Run local Trivy image scan')
        booleanParam(name: 'UPLOAD_DEFECTDOJO',             defaultValue: true,  description: 'Upload Trivy scan results to DefectDojo')
        string(name: 'DEFECTDOJO_URL',                      defaultValue: '', description: 'Optional DefectDojo base URL override')
        string(name: 'DEFECTDOJO_CREDENTIALS_ID',           defaultValue: '', description: 'Optional Jenkins secret text credential id for the DefectDojo API token')
        string(name: 'DEFECTDOJO_PRODUCT_NAME',             defaultValue: '', description: 'Optional DefectDojo product name override')
        booleanParam(name: 'ROLLBACK_MODE',                 defaultValue: false, description: 'Skip build/scan/push and update GitOps with a saved image tag')
    }

    environment {
        INFRA_REPO_URL      = credentials('infra-repo-url-micro')
        REGISTRY_REPOSITORY = credentials('register-url-micro')
        DOCKER_BUILDKIT     = '1'
    }

    stages {

        // ──────────────────────────────────────────────────────────────────────
        stage('Choose Agent') {
            steps {
                script {
                    if (isAgentOnline('istad')) {
                        env.BUILD_NODE = 'istad'
                    } else {
                        env.BUILD_NODE = 'built-in'
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Validate input') {
             agent {
                label "${env.BUILD_NODE}"
            }
            steps {
                script {
                    if (!params.REPO_URL?.trim()) {
                        error('REPO_URL is required')
                    }
                    if (!params.USER_ID?.trim()) {
                        error('USER_ID is required')
                    }

                    env.EFFECTIVE_WORKSPACE_ID = params.WORKSPACE_ID?.trim() ?: params.USER_ID.trim()
                    if (!env.EFFECTIVE_WORKSPACE_ID) {
                        error('WORKSPACE_ID is required (or falls back to USER_ID)')
                    }

                    env.EFFECTIVE_PROJECT_NAME = params.PROJECT_NAME?.trim() ?: params.APP_NAME?.trim()
                    if (!env.EFFECTIVE_PROJECT_NAME) {
                        error('PROJECT_NAME (or APP_NAME) is required')
                    }

                    if (params.ROLLBACK_MODE) {
                        if (!params.FRAMEWORK?.trim()) {
                            error('FRAMEWORK is required in rollback mode')
                        }
                        if (!params.IMAGE_TAG?.trim()) {
                            error('IMAGE_TAG is required in rollback mode')
                        }
                    }

                    def normalizedRegistry = (env.REGISTRY_REPOSITORY ?: '')
                        .trim()
                        .replaceFirst(/^https?:\/\//, '')
                        .replaceAll(/\/+$/, '')

                    if (!normalizedRegistry || !normalizedRegistry.contains('/')) {
                        error('REGISTRY_REPOSITORY must include registry host and Harbor project (example: harbor.devith.it.com/microservices-deployment)')
                    }

                    env.SAFE_USER_ID = sh(
                        script: '''echo "$USER_ID" | tr '[:upper:]' '[:lower:]' | sed -E "s/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g" | cut -c1-30''',
                        returnStdout: true
                    ).trim()
                    env.SAFE_WORKSPACE_ID = sh(
                        script: '''echo "$EFFECTIVE_WORKSPACE_ID" | tr '[:upper:]' '[:lower:]' | sed -E "s/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g" | cut -c1-30''',
                        returnStdout: true
                    ).trim()
                    env.SAFE_PROJECT_NAME = sh(
                        script: '''echo "$EFFECTIVE_PROJECT_NAME" | tr '[:upper:]' '[:lower:]' | sed -E "s/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g" | cut -c1-40''',
                        returnStdout: true
                    ).trim()
                    env.EFFECTIVE_SERVICE_NAME = params.SERVICE_NAME?.trim() ?: env.EFFECTIVE_PROJECT_NAME
                    env.EFFECTIVE_SERVICE_PATH = params.SERVICE_PATH?.trim() ?: '.'

                    env.SAFE_SERVICE_NAME = sh(
                        script: '''echo "$EFFECTIVE_SERVICE_NAME" | tr '[:upper:]' '[:lower:]' | sed -E "s/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g" | cut -c1-40''',
                        returnStdout: true
                    ).trim()

                    echo "SERVICE_NAME=${env.EFFECTIVE_SERVICE_NAME}"
                    echo "SERVICE_PATH=${env.EFFECTIVE_SERVICE_PATH}"

                    env.NORMALIZED_REGISTRY_REPOSITORY = normalizedRegistry
                    env.REGISTRY_LOGIN_SERVER          = normalizedRegistry.tokenize('/')[0]
                    env.IMAGE_REPOSITORY               = "${env.NORMALIZED_REGISTRY_REPOSITORY}/${env.SAFE_USER_ID}/${env.SAFE_PROJECT_NAME}/${env.SAFE_SERVICE_NAME}"
                    env.IMAGE_CACHE_REF  = "${env.IMAGE_REPOSITORY}:cache"

                    if (params.IMAGE_TAG?.trim()) {
                        env.IMAGE_TAG = params.IMAGE_TAG.trim()
                    }
                    if (params.FRAMEWORK?.trim()) {
                        env.FRAMEWORK = params.FRAMEWORK.trim()
                    }
                    if (env.IMAGE_TAG?.trim()) {
                        env.IMAGE_FULL = "${env.IMAGE_REPOSITORY}:${env.IMAGE_TAG}"
                    }
                    if (params.ROLLBACK_MODE) {
                        env.APP_COMMIT_SHA = "rollback-${env.IMAGE_TAG}"
                    }

                    echo "WORKSPACE_ID=${env.EFFECTIVE_WORKSPACE_ID}"
                    echo "Deployment namespace: ${env.SAFE_WORKSPACE_ID}"
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Checkout infra') {
             agent {
                label "${env.BUILD_NODE}"
            }
            steps {
                dir('platform-infra') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: env.INFRA_REPO_URL
                        ]]
                    ])
                }
                stash name: 'platform-infra-src', includes: 'platform-infra/**'
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Checkout user repository') {
             agent {
                label "${env.BUILD_NODE}"
            }
            when {
                expression { return !params.ROLLBACK_MODE }
            }
            steps {
                dir('user-app') {
                    deleteDir()
                    script {
                        def sourceProvider = normalizeSourceProvider(params.SOURCE_PROVIDER, params.REPO_URL)
                        if (isUploadedSourceProvider(sourceProvider)) {
                            if (!params.BACKEND_SOURCE_ARCHIVE_BASE_URL?.trim()) {
                                error('BACKEND_SOURCE_ARCHIVE_BASE_URL is required for uploaded source deployment')
                            }
                            if (!params.BACKEND_SOURCE_ARCHIVE_TOKEN?.trim()) {
                                error('BACKEND_SOURCE_ARCHIVE_TOKEN is required for uploaded source deployment')
                            }

                            env.APP_COMMIT_SHA = deriveUploadCommitSha(params.REPO_URL)
                            env.RESOLVED_APP_BRANCH = 'upload'

                            withEnv([
                                "UPLOAD_SOURCE_URI=${params.REPO_URL}",
                                "UPLOAD_SOURCE_BASE_URL=${params.BACKEND_SOURCE_ARCHIVE_BASE_URL}",
                                "UPLOAD_SOURCE_TOKEN=${params.BACKEND_SOURCE_ARCHIVE_TOKEN}"
                            ]) {
                                sh '''
                                    set -e
                                    set +x

                                    curl --fail --silent --show-error --location \
                                        --get \
                                        --data-urlencode "uri=${UPLOAD_SOURCE_URI}" \
                                        -H "X-Source-Archive-Token: ${UPLOAD_SOURCE_TOKEN}" \
                                        "${UPLOAD_SOURCE_BASE_URL}" \
                                        -o source.zip

                                    unzip -q source.zip
                                    rm -f source.zip
                                '''
                            }
                        } else {
                            env.NORMALIZED_REPO_URL = params.REPO_URL
                            if (params.REPO_URL?.contains('%')) {
                                try {
                                    env.NORMALIZED_REPO_URL = java.net.URLDecoder.decode(params.REPO_URL, 'UTF-8')
                                } catch (Exception ignored) {
                                    echo 'Could not decode REPO_URL — using original value.'
                                }
                            }

                            env.RESOLVED_APP_BRANCH = checkoutRepoWithBranchFallback(
                                env.NORMALIZED_REPO_URL,
                                params.REPO_CREDENTIALS_ID?.trim() ?: '',
                                params.BRANCH?.trim() ?: 'main'
                            )

                            env.APP_COMMIT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                        }

                        if (!env.IMAGE_TAG?.trim()) {
                            env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.APP_COMMIT_SHA}"
                        }
                        env.IMAGE_FULL = "${env.IMAGE_REPOSITORY}:${env.IMAGE_TAG}"

                        echo "Resolved branch : ${env.RESOLVED_APP_BRANCH}"
                        echo "Resolved image  : ${env.IMAGE_FULL}"
                    }
                }
                stash name: 'user-app-src', includes: 'user-app/**'
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Detect framework') {
             agent {
                label "${env.BUILD_NODE}"
            }
            when {
                expression { return !params.ROLLBACK_MODE }
            }
            steps {
                dir('user-app') {
                    script {
                        String scriptsDir = sh(
                            script: '''
                                set -e
                                for d in "$WORKSPACE/platform-infra/jenkins/scripts" "$WORKSPACE/plateform-infra/jenkins/scripts"; do
                                    if [ -f "$d/detect-framework.sh" ]; then echo "$d"; exit 0; fi
                                done
                                echo "ERROR: detect-framework.sh not found." >&2; exit 1
                            ''',
                            returnStdout: true
                        ).trim()

                        env.FRAMEWORK = sh(
                            script: "bash '${scriptsDir}/detect-framework.sh' '${env.EFFECTIVE_SERVICE_PATH}'",
                            returnStdout: true
                        ).trim()

                        echo "Detected framework: ${env.FRAMEWORK}"
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Detect Java runtime') {
             agent {
                label "${env.BUILD_NODE}"
            }
            when {
                expression { return !params.ROLLBACK_MODE && params.ENABLE_SONARQUBE_SCAN }
            }
            steps {
                dir('user-app') {
                    script {
                        String scriptsDir = sh(
                            script: '''
                                set -e
                                for d in "$WORKSPACE/platform-infra/jenkins/scripts" "$WORKSPACE/plateform-infra/jenkins/scripts"; do
                                    if [ -f "$d/detect-java-version.sh" ]; then echo "$d"; exit 0; fi
                                done
                                exit 0
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!scriptsDir) {
                            env.JAVA_TOOLCHAIN_VERSION = ''
                            echo 'Java version detection script not found — using node default Java runtime.'
                            return
                        }

                        env.JAVA_TOOLCHAIN_VERSION = sh(
                            script: "bash '${scriptsDir}/detect-java-version.sh'",
                            returnStdout: true
                        ).trim()

                        echo env.JAVA_TOOLCHAIN_VERSION
                            ? "Detected Java runtime requirement: ${env.JAVA_TOOLCHAIN_VERSION}"
                            : 'No explicit Java runtime requirement — using node default.'
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('SonarQube Analysis') {
             agent {
                label "${env.BUILD_NODE}"
            }
            when {
                expression { return !params.ROLLBACK_MODE && params.ENABLE_SONARQUBE_SCAN }
            }
            steps {
                script {
                    def sonarRelativeDir = normalizeServiceRelativeDir(env.EFFECTIVE_SERVICE_PATH)
                    def sonarDir = sonarRelativeDir == '.' ? 'user-app' : "user-app/${sonarRelativeDir}"
                    dir(sonarDir) {
                        sh '''
                            set -e
                            REPO_ROOT="${WORKSPACE}/user-app"
                            SERVICE_PATH="${EFFECTIVE_SERVICE_PATH:-.}"
                            SERVICE_MODULE="${SERVICE_MODULE:-}"

                            if [ ! -f "./gradlew" ] && [ -f "${REPO_ROOT}/gradlew" ]; then
                                ROOT_HAS_GRADLE_BUILD="false"
                                if [ -f "${REPO_ROOT}/settings.gradle" ] || \
                                   [ -f "${REPO_ROOT}/settings.gradle.kts" ] || \
                                   [ -f "${REPO_ROOT}/build.gradle" ] || \
                                   [ -f "${REPO_ROOT}/build.gradle.kts" ]; then
                                    ROOT_HAS_GRADLE_BUILD="true"
                                fi

                                if [ -z "${SERVICE_MODULE}" ] && \
                                   [ "${ROOT_HAS_GRADLE_BUILD}" = "true" ] && \
                                   [ -n "${SERVICE_PATH}" ] && \
                                   [ "${SERVICE_PATH}" != "." ]; then
                                    SERVICE_MODULE=":$(printf '%s' "${SERVICE_PATH}" | sed 's#^\\./##; s#/$##; s#/#:#g')"
                                fi

                                if [ -n "${SERVICE_MODULE}" ]; then
                                    chmod +x "${REPO_ROOT}/gradlew" || true
                                    cat > ./gradlew <<EOF
#!/bin/sh
set -eu
ROOT_DIR="${REPO_ROOT}"
SERVICE_MODULE="${SERVICE_MODULE}"
case "\${1:-}" in
classes|testClasses|compileJava|compileTestJava)
    TASK="\$1"
    shift
    exec "\$ROOT_DIR/gradlew" "\${SERVICE_MODULE}:\${TASK}" "\$@"
    ;;
esac
exec "\$ROOT_DIR/gradlew" "\$@"
EOF
                                    chmod +x ./gradlew
                                    echo "[sonar] Prepared Gradle mono-repo wrapper shim for ${SERVICE_MODULE}"
                                fi
                            fi
                        '''
                        script {
                            sh '''
                                set -e
                                echo "[sonar-path] pwd=$(pwd)"
                                echo "[sonar-path] service_path=${EFFECTIVE_SERVICE_PATH:-.}"
                                echo "[sonar-path] module=${SERVICE_MODULE:-}"
                                echo "[sonar-path] sample files:"
                                find . -maxdepth 3 -type f | sort | head -n 50
                                echo "[sonar-path] java_count=$(find . -type f -name '*.java' | wc -l | tr -d ' ')"
                                echo "[sonar-path] ts_count=$(find . -type f | grep -E '\\.(ts|tsx)$' | wc -l | tr -d ' ')"
                                echo "[sonar-path] js_count=$(find . -type f | grep -E '\\.(js|jsx)$' | wc -l | tr -d ' ')"
                            '''
                            def sonarServer = params.SONARQUBE_SERVER_NAME?.trim() ?: 'sonarqube'
                            def sonarWork = {
                                withSonarQubeEnv(sonarServer) {
                                    String sonarAuthToken = env.SONAR_AUTH_TOKEN?.trim()

                                    if (!sonarAuthToken) {
                                        error("SonarQube server '${sonarServer}' did not provide SONAR_AUTH_TOKEN. Check Jenkins -> Manage Jenkins -> System -> SonarQube servers.")
                                    }

                                    withEnv(["SONAR_TOKEN=${sonarAuthToken}"]) {
                                        a8sSonarScan(
                                            server        : sonarServer,
                                            scannerTool   : params.SONARQUBE_SCANNER_TOOL?.trim(),
                                            projectKey    : "${env.SAFE_WORKSPACE_ID}-${env.SAFE_PROJECT_NAME}-${env.SAFE_SERVICE_NAME}",
                                            projectName   : "${env.EFFECTIVE_PROJECT_NAME}-${env.EFFECTIVE_SERVICE_NAME}",
                                            projectVersion: env.APP_COMMIT_SHA,
                                            sources       : '.',
                                            exclusions    : '**/node_modules/**,**/.next/**,**/dist/**,**/build/**,**/target/**,**/vendor/**,**/.git/**'
                                        )
                                    }
                                }
                            }

                            if (env.JAVA_TOOLCHAIN_VERSION?.trim()) {
                                def jdkPrefix = params.SONARQUBE_JDK_TOOL_PREFIX?.trim() ?: 'jdk'
                                def toolName  = "${jdkPrefix}${env.JAVA_TOOLCHAIN_VERSION.trim()}"
                                def javaHome
                                try {
                                    javaHome = tool name: toolName, type: 'hudson.model.JDK'
                                } catch (Exception ex) {
                                    error("Java ${env.JAVA_TOOLCHAIN_VERSION} required for SonarQube but JDK tool '${toolName}' is not configured on this node.")
                                }
                                withEnv([
                                    "JAVA_HOME=${javaHome}",
                                    "PATH=${javaHome}/bin:${env.PATH}",
                                    "ORG_GRADLE_JAVA_HOME=${javaHome}",
                                    "ORG_GRADLE_JAVA_INSTALLATIONS_PATHS=${javaHome}"
                                ]) {
                                    sh 'java -version; command -v javac >/dev/null 2>&1 && javac -version || true'
                                    sonarWork()
                                }
                            } else {
                                sonarWork()
                            }
                        }
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('SonarQube Quality Gate') {
             agent {
                label "${env.BUILD_NODE}"
            }
            when {
                expression {
                    return !params.ROLLBACK_MODE &&
                        params.ENABLE_SONARQUBE_SCAN &&
                        params.ENABLE_SONARQUBE_QUALITY_GATE
                }
            }
            steps {
                a8sSonarQualityGate(timeoutMinutes: 5, abortPipeline: true)
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        // Build, scan, and push all happen on the same istad agent so the image
        // stays in the local Docker daemon — no docker save / stash / docker load
        // round-trip needed.
        stage('Build → Scan → Push') {
             agent {
                label "${env.BUILD_NODE}"
            }
            when {
                expression { return !params.ROLLBACK_MODE }
            }
            steps {
                script {
                    echo "[deploy] Preparing build workspace for ${env.EFFECTIVE_SERVICE_NAME}"
                    dir('platform-infra') { deleteDir() }
                    dir('user-app')       { deleteDir() }

                    unstash 'platform-infra-src'
                    unstash 'user-app-src'

                    // ── Generate / Detect Dockerfile ─────────────────────
                    dir('user-app') {
                        sh '''
                            set -e
                            set +x

                            SERVICE_PATH="${EFFECTIVE_SERVICE_PATH:-.}"
                            DOCKERFILE_META_FILE=".jenkins-dockerfile-meta"
                            SERVICE_MODULE="${SERVICE_MODULE:-}"

                            if [ ! -d "$SERVICE_PATH" ]; then
                                echo "ERROR: SERVICE_PATH does not exist: $SERVICE_PATH"
                                exit 1
                            fi

                            SCRIPTS_DIR=""
                            for d in "$WORKSPACE/platform-infra/jenkins/scripts" "$WORKSPACE/plateform-infra/jenkins/scripts"; do
                                if [ -f "$d/generate-dockerfile.sh" ] && [ -f "$d/resolve-dockerfile.sh" ]; then
                                    SCRIPTS_DIR="$d"
                                    break
                                fi
                            done

                            if [ -z "$SCRIPTS_DIR" ]; then
                                echo "ERROR: Dockerfile support scripts not found."
                                exit 1
                            fi

                            DOCKERFILE_PATH=$(bash "${SCRIPTS_DIR}/resolve-dockerfile.sh" "$SERVICE_PATH")

                            if [ -n "$DOCKERFILE_PATH" ]; then
                                echo "[dockerfile] Using repository Dockerfile from $DOCKERFILE_PATH"
                                if [ "$DOCKERFILE_PATH" != "$SERVICE_PATH/Dockerfile" ]; then
                                    cp "$DOCKERFILE_PATH" "$SERVICE_PATH/Dockerfile"
                                fi
                                DOCKERFILE_SOURCE="user"
                                DOCKER_BUILD_CONTEXT="$SERVICE_PATH"
                            else
                                echo "[dockerfile] No repository Dockerfile found for $SERVICE_PATH"
                                echo "[dockerfile] Generating platform Dockerfile for ${FRAMEWORK}"

                                cd "$SERVICE_PATH"
                                bash "${SCRIPTS_DIR}/generate-dockerfile.sh" "${FRAMEWORK}" "${SCRIPTS_DIR}"

                                if [ ! -f Dockerfile ]; then
                                    echo "ERROR: Dockerfile generation failed in $SERVICE_PATH"
                                    exit 1
                                fi

                                DOCKERFILE_SOURCE="generated"
                                DOCKER_BUILD_CONTEXT="."
                                if [ -n "$SERVICE_PATH" ] && [ "$SERVICE_PATH" != "." ] && [ -z "$SERVICE_MODULE" ]; then
                                    DOCKER_BUILD_CONTEXT="$SERVICE_PATH"
                                fi
                            fi

                            echo "[dockerfile] Final Dockerfile ready at $SERVICE_PATH/Dockerfile"
                            echo "[dockerfile] Build context: ${DOCKER_BUILD_CONTEXT}"

                            {
                                echo "DOCKERFILE_PATH=${SERVICE_PATH}/Dockerfile"
                                echo "DOCKER_BUILD_CONTEXT=${DOCKER_BUILD_CONTEXT}"
                                echo "DOCKERFILE_SOURCE=${DOCKERFILE_SOURCE}"
                            } > "${DOCKERFILE_META_FILE}"
                        '''
                    }

                    // ── Registry login ───────────────────────────────────
                    withCredentials([usernamePassword(
                        credentialsId: 'registry-credentials',
                        usernameVariable: 'REGISTRY_USERNAME',
                        passwordVariable: 'REGISTRY_PASSWORD'
                    )]) {

                        sh '''
                            set +x
                            echo "[auth] Logging in to ${REGISTRY_LOGIN_SERVER}"
                            echo "${REGISTRY_PASSWORD}" | docker login "${REGISTRY_LOGIN_SERVER}" \
                                -u "${REGISTRY_USERNAME}" --password-stdin
                        '''

                        // ── Build ─────────────────────────────────────────
                        dir('user-app') {
                            sh '''
                                set +x
                                SERVICE_PATH="${EFFECTIVE_SERVICE_PATH:-.}"
                                DOCKERFILE_META_FILE=".jenkins-dockerfile-meta"
                                DOCKERFILE_PATH="${SERVICE_PATH}/Dockerfile"
                                DOCKER_BUILD_CONTEXT="."
                                DOCKERFILE_SOURCE="generated"

                                if [ -f "${DOCKERFILE_META_FILE}" ]; then
                                    . "./${DOCKERFILE_META_FILE}"
                                fi

                                if [ "${DOCKER_BUILD_CONTEXT}" = "." ] && \
                                   [ "${DOCKERFILE_SOURCE}" = "generated" ] && \
                                   [ -n "${SERVICE_PATH}" ] && \
                                   [ "${SERVICE_PATH}" != "." ] && \
                                   [ -z "${SERVICE_MODULE:-}" ] && \
                                   [ ! -f "settings.gradle" ] && \
                                   [ ! -f "settings.gradle.kts" ] && \
                                   [ ! -f "build.gradle" ] && \
                                   [ ! -f "build.gradle.kts" ]; then
                                    DOCKER_BUILD_CONTEXT="${SERVICE_PATH}"
                                fi

                                CACHE_FROM_ARG=""
                                CACHE_POLICY_ARG="--no-cache"
                                EFFECTIVE_SERVICE_MODULE=""

                                echo "[cache] Attempting to pull ${IMAGE_CACHE_REF}"
                                if docker pull "${IMAGE_CACHE_REF}" > /dev/null 2>&1; then
                                    CACHE_FROM_ARG="--cache-from ${IMAGE_CACHE_REF}"
                                    CACHE_POLICY_ARG=""
                                    echo "[cache] Cache hit — layers will be reused"
                                else
                                    echo "[cache] No cache image — building from scratch"
                                fi

                                ROOT_HAS_GRADLE_BUILD="false"
                                if [ -f "settings.gradle" ] || \
                                   [ -f "settings.gradle.kts" ] || \
                                   [ -f "build.gradle" ] || \
                                   [ -f "build.gradle.kts" ]; then
                                    ROOT_HAS_GRADLE_BUILD="true"
                                fi

                                if [ -n "${SERVICE_MODULE:-}" ]; then
                                    EFFECTIVE_SERVICE_MODULE="${SERVICE_MODULE}"
                                elif printf '%s' "${FRAMEWORK:-}" | tr '[:upper:]' '[:lower:]' | grep -q 'gradle' && \
                                     [ "${ROOT_HAS_GRADLE_BUILD}" = "true" ]; then
                                    if [ -n "${SERVICE_PATH}" ] && [ "${SERVICE_PATH}" != "." ]; then
                                        EFFECTIVE_SERVICE_MODULE=":$(printf '%s' "${SERVICE_PATH}" | sed 's#^\\./##; s#/$##; s#/#:#g')"
                                    fi
                                fi

                                echo "[build] Building ${IMAGE_FULL}"
                                echo "[build] Dockerfile: ${DOCKERFILE_PATH}"
                                echo "[build] Context: ${DOCKER_BUILD_CONTEXT}"
                                echo "[build] Dockerfile source: ${DOCKERFILE_SOURCE}"
                                echo "[build] Derived service module: ${EFFECTIVE_SERVICE_MODULE:-<root>}"

                                docker build \
                                    ${CACHE_POLICY_ARG} \
                                    ${CACHE_FROM_ARG} \
                                    --build-arg BUILDKIT_INLINE_CACHE=1 \
                                    --build-arg SERVICE_PATH="${SERVICE_PATH}" \
                                    --build-arg SERVICE_MODULE="${EFFECTIVE_SERVICE_MODULE}" \
                                    -f "${DOCKERFILE_PATH}" \
                                    -t "${IMAGE_FULL}" \
                                    -t "${IMAGE_CACHE_REF}" \
                                    "${DOCKER_BUILD_CONTEXT}"

                                echo "[build] Container image built successfully"
                            '''
                        }

                        // ── Scan ──────────────────────────────────────────
                        script {
                            def JENKINS_HOME_DIR = "/home/istad/jenkins"
                            if (params.ENABLE_TRIVY_SCAN) {
                                def trivyBaseDir = "${JENKINS_HOME_DIR}/trivy"
                                def trivyCacheBase = "${JENKINS_HOME_DIR}/trivy-cache-${env.JOB_NAME?.replaceAll('[^A-Za-z0-9_.-]+', '-') ?: 'job'}"

                                def trivyPath = "${trivyBaseDir}/docker-compose.yml"
                                def trivyReportFileName = "trivy-report-${env.SAFE_SERVICE_NAME ?: 'service'}-${env.BUILD_NUMBER}.json"
                                def reportPath = "${trivyBaseDir}/reports/${trivyReportFileName}"
                                
                                def trivyCacheSeedDir = "${trivyCacheBase}-seed"
                                def trivyCacheDir     = "${trivyCacheBase}-${env.BUILD_NUMBER}"
                                def trivyCacheLockFile = "${trivyCacheBase}.lock"
                                def trivyTimeout = "30m"

                                sh """
                                    mkdir -p "/home/istad/jenkins/trivy/reports"
                                    flock -w 1800 "${trivyCacheLockFile}" \
                                      docker compose -f "${trivyPath}" exec --no-TTY trivy sh -lc '
                                        set -e
                                        mkdir -p "${trivyCacheSeedDir}"
                                        trivy image --cache-dir "${trivyCacheSeedDir}" --download-db-only
                                        trivy image --cache-dir "${trivyCacheSeedDir}" --download-java-db-only || true
                                        rm -rf "${trivyCacheDir}"
                                        mkdir -p "${trivyCacheDir}"
                                        cp -a "${trivyCacheSeedDir}/." "${trivyCacheDir}/"
                                      '
                                """

                                echo "[scan] Starting Trivy scan for ${env.IMAGE_FULL} (timeout: ${trivyTimeout})"

                                sh """
                                    set -e
                                    docker compose -f "${trivyPath}" exec --no-TTY trivy \
                                    trivy image \
                                    --cache-dir "${trivyCacheDir}" \
                                    --timeout "${trivyTimeout}" \
                                    --skip-version-check \
                                    --scanners vuln,misconfig \
                                    --no-progress \
                                    --exit-code 0 \
                                    --severity HIGH,CRITICAL \
                                    --format json \
                                    -o "/reports/${trivyReportFileName}" \
                                    "${env.IMAGE_FULL}"
                                """

                                sh """
                                    echo "=== VERIFY TRIVY REPORT ==="

                                    docker compose -f "${trivyPath}" exec --no-TTY trivy \
                                    sh -c 'ls -lah /reports'

                                    ls -lah "${trivyBaseDir}/reports"

                                    docker compose -f "${trivyPath}" exec --no-TTY trivy \
                                    test -f "/reports/${trivyReportFileName}"
                                """

                                def findingCount = sh(
                                    script: """
                                        set -e
                                        docker compose -f "${trivyPath}" exec --no-TTY trivy \
                                        trivy image \
                                        --cache-dir "${trivyCacheDir}" \
                                        --timeout "${trivyTimeout}" \
                                        --skip-version-check \
                                        --scanners vuln \
                                        --no-progress \
                                        --exit-code 0 \
                                        --severity HIGH,CRITICAL \
                                        --format table \
                                        "${env.IMAGE_FULL}" 2>&1 | grep -cE 'HIGH|CRITICAL' || true
                                    """,
                                    returnStdout: true
                                ).trim().toInteger()

                                echo "[scan] ${findingCount} HIGH/CRITICAL finding(s)"
                                def defectDojoUrl = params.DEFECTDOJO_URL?.trim()
                                def defectDojoCredentialId = params.DEFECTDOJO_CREDENTIALS_ID?.trim()
                                def defectDojoProductName = params.DEFECTDOJO_PRODUCT_NAME?.trim()
                                def defectDojoProductTypeName = defectDojoProductName?.startsWith('Workspace - ')
                                    ? 'Workspace Projects'
                                    : 'Web Applications'

                                if (params.UPLOAD_DEFECTDOJO && defectDojoUrl && defectDojoCredentialId && defectDojoProductName) {
                                    echo "[scan] Uploading report to DefectDojo (productType=${defectDojoProductTypeName}, productName=${defectDojoProductName})"
                                    def callbackBaseUrl = params.BACKEND_CALLBACK_URL?.trim()
                                    def callbackCredentialId = params.BACKEND_CALLBACK_CREDENTIALS_ID?.trim()
                                    def callbackToken = params.BACKEND_CALLBACK_TOKEN?.trim()
                                    def canFetchDefectDojoToken = callbackBaseUrl && (callbackCredentialId || callbackToken) && env.EFFECTIVE_WORKSPACE_ID
                                    def defectDojoTokenFetchUrl = canFetchDefectDojoToken
                                        ? "${callbackBaseUrl}/api/internal/microservices/defectdojo-token?workspaceId=${env.EFFECTIVE_WORKSPACE_ID}"
                                        : ""
                                    try {
                                        if (canFetchDefectDojoToken) {
                                        def uploadScript = """
                                            set -e

                                            echo "Fetching DefectDojo token..."

                                            DEFECTDOJO_API_KEY=\$(curl -fsS \
                                            -H "Authorization: Bearer \${BACKEND_CALLBACK_AUTH_TOKEN}" \
                                            "${defectDojoTokenFetchUrl}")

                                            echo "\$DEFECTDOJO_API_KEY"

                                            echo "\$response_file"

                                            echo "\$http_code"

                                            if [ -z "\$DEFECTDOJO_API_KEY" ]; then
                                            echo "[scan] backend callback returned an empty DefectDojo token"
                                            exit 1
                                            fi

                                            echo "[scan] Waiting for Trivy report: ${reportPath}"

                                            for i in \$(seq 1 15); do
                                            if [ -f "${reportPath}" ]; then
                                                echo "[scan] Report found"
                                                break
                                            fi

                                            echo "[scan] Waiting for report (\$i/15)..."
                                            sleep 2
                                            done

                                            if [ ! -f "${reportPath}" ]; then
                                            echo "[scan] ERROR: Report file not found"
                                            echo "[scan] Contents of report directory:"
                                            ls -lah /home/istad/jenkins/trivy/reports || true
                                            exit 1
                                            fi

                                            echo "[scan] Report details:"
                                            ls -lah "${reportPath}"
                                            wc -c "${reportPath}"

                                            attempt=1
                                            max_attempts=3

                                            while [ \$attempt -le \$max_attempts ]; do
                                            echo "[scan] DefectDojo upload attempt \$attempt/\$max_attempts"

                                            response_file=\$(mktemp)

                                            http_code=\$(curl -sS -k \
                                                -o "\$response_file" \
                                                -w "%{http_code}" \
                                                -X POST "${defectDojoUrl}/api/v2/reimport-scan/" \
                                                -H "Authorization: Token \${DEFECTDOJO_API_KEY}" \
                                                -F "scan_type=Trivy Scan" \
                                                -F "file=@${reportPath}" \
                                                -F "auto_create_context=true" \
                                                -F "product_type_name=${defectDojoProductTypeName}" \
                                                -F "product_name=${defectDojoProductName}" \
                                                -F "engagement_name=Jenkins-${env.BUILD_NUMBER}-${env.EFFECTIVE_SERVICE_NAME}" \
                                                -F "test_title=Trivy Image Scan - ${env.EFFECTIVE_SERVICE_NAME} - ${env.IMAGE_TAG}" \
                                                -F "active=true" \
                                                -F "verified=true" \
                                                -F "close_old_findings=true")

                                            echo "[defectdojo] HTTP \$http_code"
                                            echo "[defectdojo] response:"
                                            cat "\$response_file"

                                            if [ "\$http_code" -ge 200 ] && [ "\$http_code" -lt 300 ]; then
                                                echo "[scan] DefectDojo upload successful"
                                                rm -f "\$response_file"
                                                exit 0
                                            fi

                                            rm -f "\$response_file"

                                            if [ \$attempt -lt \$max_attempts ]; then
                                                echo "[scan] Upload failed, retrying in 5 seconds..."
                                                sleep 5
                                            fi

                                            attempt=\$((attempt + 1))
                                            done

                                            echo "[scan] DefectDojo upload failed after \$max_attempts attempts"
                                            exit 1
                                        """
                                            if (callbackCredentialId) {
                                                withCredentials([string(credentialsId: callbackCredentialId, variable: 'BACKEND_CALLBACK_AUTH_TOKEN')]) {
                                                    sh uploadScript
                                                }
                                            } else {
                                                withEnv(["BACKEND_CALLBACK_AUTH_TOKEN=${callbackToken}"]) {
                                                    sh uploadScript
                                                }
                                            }
                                        } else {
                                            withCredentials([string(credentialsId: defectDojoCredentialId, variable: 'DEFECTDOJO_API_KEY')]) {
                                                sh """
                                                    set -e
                                                    response_file=\$(mktemp)
                                                    http_code=\$(curl -sS -k -o "\$response_file" -w "%{http_code}" -X POST "${defectDojoUrl}/api/v2/reimport-scan/" \
                                                      -H "Authorization: Token \${DEFECTDOJO_API_KEY}" \
                                                      -F "scan_type=Trivy Scan" \
                                                      -F "file=@${reportPath}" \
                                                      -F "auto_create_context=true" \
                                                      -F "product_type_name=${defectDojoProductTypeName}" \
                                                      -F "product_name=${defectDojoProductName}" \
                                                      -F "engagement_name=Jenkins-${env.BUILD_NUMBER}-${env.EFFECTIVE_SERVICE_NAME}" \
                                                      -F "test_title=Trivy Image Scan - ${env.EFFECTIVE_SERVICE_NAME} - ${env.IMAGE_TAG}" \
                                                      -F "active=true" \
                                                      -F "verified=true" \
                                                      -F "close_old_findings=true")

                                                    echo "[defectdojo] HTTP \$http_code"
                                                    echo "[defectdojo] response:"
                                                    cat "\$response_file"

                                                    if [ "\$http_code" -lt 200 ] || [ "\$http_code" -ge 300 ]; then
                                                      rm -f "\$response_file"
                                                      exit 22
                                                    fi

                                                    echo "[scan] DefectDojo curl returned successfully"
                                                    rm -f "\$response_file"
                                                """
                                            }
                                        }
                                    } catch (err) {
                                        echo "[scan] DefectDojo upload failed"
                                        echo err.toString()
                                        throw err
                                    }

                                    echo "[scan] DefectDojo upload completed"
                                } else {
                                    echo '[scan] DefectDojo upload skipped because workspace-specific DefectDojo configuration is incomplete.'
                                }


                                // security gate: fail build if any CRITICAL vulnerability found
                                sh """
                                    set -e
                                    docker compose -f "${trivyPath}" exec --no-TTY trivy \
                                      trivy image \
                                      --cache-dir "${trivyCacheDir}" \
                                      --timeout "${trivyTimeout}" \
                                      --skip-version-check \
                                      --scanners vuln \
                                      --severity CRITICAL \
                                      --exit-code 1 \
                                      --no-progress \
                                      "${env.IMAGE_FULL}"
                                """

                                sh """
                                    docker compose -f "${trivyPath}" exec --no-TTY trivy sh -lc 'rm -rf "${trivyCacheDir}"'
                                """
                                sh """
                                    docker compose -f "${trivyPath}" exec --no-TTY trivy sh -lc 'rm -f "/reports/${trivyReportFileName}"' || true
                                    rm -f "${reportPath}" || true
                                """
                            } else {
                                echo '[scan] ENABLE_TRIVY_SCAN=false — skipping.'
                            }
                        }

                        // ── Push ──────────────────────────────────────────
                        sh '''
                            set +x
                            echo "[push] Pushing versioned image ${IMAGE_FULL}"
                            docker push "${IMAGE_FULL}"

                            echo "[push] Pushing cache tag ${IMAGE_CACHE_REF}"
                            docker push "${IMAGE_CACHE_REF}"

                            echo "[push] Image publish completed"
                        '''
                    }
                }
            }
            post {
                always {
                    sh '''
                        set +x
                        docker rmi "${IMAGE_FULL}" "${IMAGE_CACHE_REF}" || true
                        docker image prune -f || true
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "[success] Deployment artifact ready for ${env.EFFECTIVE_PROJECT_NAME} — ${env.IMAGE_FULL}"
        }
        failure {
            echo "[error] Build failed for ${env.EFFECTIVE_PROJECT_NAME}. Review the deployment log for the failing step."
        }
        always {
            script {
                echo '[deploy] Build workspace kept on disk for Git and layer cache reuse.'
            }
        }
    }
}

// ─── Helper functions ─────────────────────────────────────────────────────────

def buildRepoBranchCandidates(String requestedBranch) {
    def normalized = requestedBranch?.toString()?.trim()
    if (!normalized) {
        return ['main', 'master']
    }
    if (normalized.startsWith('refs/tags/')) {
        return [normalized]
    }
    def candidates = [normalized]
    if (normalized == 'main')        { candidates << 'master' }
    else if (normalized == 'master') { candidates << 'main' }
    return candidates.unique()
}

def deriveUploadCommitSha(String archiveUri) {
    def normalized = archiveUri?.toString()?.trim() ?: ''
    if (!normalized) {
        return Integer.toHexString(Math.abs('upload'.hashCode())).take(12)
    }
    def archiveName = normalized.tokenize('/').last()
    def archiveHash = archiveName?.tokenize('-')?.first()
    return (archiveHash ?: Integer.toHexString(Math.abs(normalized.hashCode()))).take(12)
}

def normalizeSourceProvider(def rawProvider, def repoUrl) {
    def provider = rawProvider?.toString()?.trim()?.toLowerCase() ?: ''
    if (isUploadedSourceProvider(provider)) {
        return 'upload'
    }

    def normalizedRepoUrl = repoUrl?.toString()?.trim()?.toLowerCase() ?: ''
    if (normalizedRepoUrl.startsWith('s3://') || normalizedRepoUrl.startsWith('local://') || normalizedRepoUrl.endsWith('.zip')) {
        return 'upload'
    }

    return provider ?: 'github'
}

def isUploadedSourceProvider(def provider) {
    def normalized = provider?.toString()?.trim()?.toLowerCase() ?: ''
    return normalized in ['upload', 'local', 'zip']
}

def checkoutRepoWithBranchFallback(String repoUrl, String credentialsId, String requestedBranch) {
    def candidates = buildRepoBranchCandidates(requestedBranch)
    def lastError  = null

    sh '''
        if [ -d .git ]; then
            git -C . clean -fdx || true
            git -C . reset --hard || true
        fi
        rm -rf .gradle-home .gradle .m2 target build dist node_modules || true
    '''

    for (String candidate : candidates) {
        try {
            if (candidate.startsWith('refs/tags/')) {
                def tagName = candidate.substring('refs/tags/'.length())
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/tags/${tagName}"]],
                    userRemoteConfigs: [[
                        url: repoUrl,
                        credentialsId: credentialsId?.trim() ?: null,
                        refspec: "+refs/tags/${tagName}:refs/tags/${tagName}"
                    ]],
                    extensions: [
                        [$class: 'CloneOption',   shallow: true, depth: 1, noTags: false, honorRefspec: true, timeout: 60],
                        [$class: 'CheckoutOption', timeout: 60],
                        [$class: 'CleanBeforeCheckout', deleteUntrackedNestedRepositories: true]
                    ]
                ])
                return candidate
            }

            checkout([
                $class: 'GitSCM',
                branches: [[name: "*/${candidate}"]],
                userRemoteConfigs: [[
                    url: repoUrl,
                    credentialsId: credentialsId?.trim() ?: null
                ]],
                extensions: [
                    [$class: 'CloneOption',   shallow: true, depth: 1, noTags: true, honorRefspec: true, timeout: 60],
                    [$class: 'CheckoutOption', timeout: 60],
                    [$class: 'CleanBeforeCheckout', deleteUntrackedNestedRepositories: true]
                ]
            ])
            return candidate

        } catch (Exception err) {
            lastError = err
            echo "Checkout failed for branch '${candidate}' from ${repoUrl}: ${err.getMessage()}"
            if (!isBranchResolutionFailure(err)) {
                throw err
            }
            sh 'rm -rf .git .gradle-home .gradle || true'
        }
    }

    throw lastError ?: new RuntimeException("Could not checkout ${repoUrl}")
}

def isBranchResolutionFailure(Exception err) {
    def message = err?.getMessage() ?: ''
    def isResolutionFailure = message.contains("Couldn't find any revision to build") ||
        message.contains("Couldn't find remote ref") ||
        message.contains("Couldn't find branch") ||
        message.contains("Couldn't find any commit") ||
        message.contains("Couldn't resolve")
    return isResolutionFailure
}

def normalizeServiceRelativeDir(String rawPath) {
    def normalized = rawPath?.toString()?.trim()
    if (!normalized || normalized == '.' || normalized == './') {
        return '.'
    }
    normalized = normalized.replace('\\', '/')
    normalized = normalized.replaceFirst(/^\.\/+/, '')
    normalized = normalized.replaceFirst(/\/+$/, '')
    return normalized ?: '.'
}
