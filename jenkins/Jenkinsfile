@Library(['share_lib@master', 'a8s-sonarqube@main']) _

pipeline {
    agent { label 'istad' }

    options {
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    parameters {
        string(name: 'REPO_URL',                  defaultValue: '', description: 'Git repository URL from user (GitHub/GitLab)')
        string(name: 'BRANCH',                    defaultValue: 'main', description: 'Git branch to build')
        string(name: 'USER_ID',                   defaultValue: '', description: 'Tenant user id')
        string(name: 'WORKSPACE_ID',              defaultValue: '', description: 'Workspace id/slug for GitOps path partitioning and Kubernetes namespace')
        string(name: 'PROJECT_NAME',              defaultValue: '', description: 'Project slug')
        string(name: 'APP_NAME',                  defaultValue: '', description: 'Legacy alias for PROJECT_NAME')
        string(name: 'IMAGE_TAG',                 defaultValue: '', description: 'Optional image tag provided by backend (deploy or rollback)')
        string(name: 'FRAMEWORK',                 defaultValue: '', description: 'Optional framework override provided by backend')
        string(name: 'REPO_CREDENTIALS_ID',       defaultValue: '', description: 'Optional Jenkins credential id for private user repositories')
        string(name: 'SONARQUBE_SERVER_NAME',     defaultValue: 'sonarqube', description: 'Jenkins SonarQube server configuration name')
        string(name: 'SONARQUBE_SCANNER_TOOL',    defaultValue: '', description: 'Optional Jenkins SonarScanner tool name; empty uses sonar-scanner from PATH')
        string(name: 'SONARQUBE_JDK_TOOL_PREFIX', defaultValue: 'jdk', description: 'Jenkins JDK tool name prefix used for Java SonarQube analysis (example: jdk -> jdk21)')
        booleanParam(name: 'ENABLE_SONARQUBE_SCAN',         defaultValue: false, description: 'Run SonarQube source analysis')
        booleanParam(name: 'ENABLE_SONARQUBE_QUALITY_GATE', defaultValue: false, description: 'Wait for SonarQube quality gate before build')
        booleanParam(name: 'ENABLE_TRIVY_SCAN',             defaultValue: true,  description: 'Run local Trivy image scan')
        booleanParam(name: 'ROLLBACK_MODE',                 defaultValue: false, description: 'Skip build/scan/push and update GitOps with a saved image tag')
    }

    environment {
        INFRA_REPO_URL      = credentials('infra-repo-url-micro')
        REGISTRY_REPOSITORY = credentials('register-url-micro')
        DOCKER_BUILDKIT     = '1'
    }

    stages {

        // ──────────────────────────────────────────────────────────────────────
        stage('Validate input') {
            steps {
                script {
                    if (!params.REPO_URL?.trim()) {
                        error('REPO_URL is required')
                    }
                    if (!params.USER_ID?.trim()) {
                        error('USER_ID is required')
                    }

                    env.EFFECTIVE_WORKSPACE_ID = params.WORKSPACE_ID?.trim() ?: params.USER_ID.trim()
                    if (!env.EFFECTIVE_WORKSPACE_ID) {
                        error('WORKSPACE_ID is required (or falls back to USER_ID)')
                    }

                    env.EFFECTIVE_PROJECT_NAME = params.PROJECT_NAME?.trim() ?: params.APP_NAME?.trim()
                    if (!env.EFFECTIVE_PROJECT_NAME) {
                        error('PROJECT_NAME (or APP_NAME) is required')
                    }

                    if (params.ROLLBACK_MODE) {
                        if (!params.FRAMEWORK?.trim()) {
                            error('FRAMEWORK is required in rollback mode')
                        }
                        if (!params.IMAGE_TAG?.trim()) {
                            error('IMAGE_TAG is required in rollback mode')
                        }
                    }

                    def normalizedRegistry = (env.REGISTRY_REPOSITORY ?: '')
                        .trim()
                        .replaceFirst(/^https?:\/\//, '')
                        .replaceAll(/\/+$/, '')

                    if (!normalizedRegistry || !normalizedRegistry.contains('/')) {
                        error('REGISTRY_REPOSITORY must include registry host and Harbor project (example: harbor.devith.it.com/microservices-deployment)')
                    }

                    env.SAFE_USER_ID = sh(
                        script: '''echo "$USER_ID" | tr '[:upper:]' '[:lower:]' | sed -E "s/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g" | cut -c1-30''',
                        returnStdout: true
                    ).trim()
                    env.SAFE_WORKSPACE_ID = sh(
                        script: '''echo "$EFFECTIVE_WORKSPACE_ID" | tr '[:upper:]' '[:lower:]' | sed -E "s/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g" | cut -c1-30''',
                        returnStdout: true
                    ).trim()
                    env.SAFE_PROJECT_NAME = sh(
                        script: '''echo "$EFFECTIVE_PROJECT_NAME" | tr '[:upper:]' '[:lower:]' | sed -E "s/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g" | cut -c1-40''',
                        returnStdout: true
                    ).trim()

                    env.NORMALIZED_REGISTRY_REPOSITORY = normalizedRegistry
                    env.REGISTRY_LOGIN_SERVER          = normalizedRegistry.tokenize('/')[0]
                    env.IMAGE_REPOSITORY               = "${env.NORMALIZED_REGISTRY_REPOSITORY}/${env.SAFE_USER_ID}/${env.SAFE_PROJECT_NAME}"
                    env.IMAGE_CACHE_REF                = "${env.IMAGE_REPOSITORY}:latest"

                    if (params.IMAGE_TAG?.trim()) {
                        env.IMAGE_TAG = params.IMAGE_TAG.trim()
                    }
                    if (params.FRAMEWORK?.trim()) {
                        env.FRAMEWORK = params.FRAMEWORK.trim()
                    }
                    if (env.IMAGE_TAG?.trim()) {
                        env.IMAGE_FULL = "${env.IMAGE_REPOSITORY}:${env.IMAGE_TAG}"
                    }
                    if (params.ROLLBACK_MODE) {
                        env.APP_COMMIT_SHA = "rollback-${env.IMAGE_TAG}"
                    }

                    echo "WORKSPACE_ID=${env.EFFECTIVE_WORKSPACE_ID}"
                    echo "Deployment namespace: ${env.SAFE_WORKSPACE_ID}"
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Checkout infra') {
            steps {
                dir('platform-infra') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: env.INFRA_REPO_URL,
                            credentialsId: 'infra-repo-creds'
                        ]]
                    ])
                }
                stash name: 'platform-infra-src', includes: 'platform-infra/**'
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Checkout user repository') {
            when {
                expression { return !params.ROLLBACK_MODE }
            }
            steps {
                dir('user-app') {
                    deleteDir()
                    script {
                        env.NORMALIZED_REPO_URL = params.REPO_URL
                        if (params.REPO_URL?.contains('%')) {
                            try {
                                env.NORMALIZED_REPO_URL = java.net.URLDecoder.decode(params.REPO_URL, 'UTF-8')
                            } catch (Exception ignored) {
                                echo 'Could not decode REPO_URL — using original value.'
                            }
                        }

                        env.RESOLVED_APP_BRANCH = checkoutRepoWithBranchFallback(
                            env.NORMALIZED_REPO_URL,
                            params.REPO_CREDENTIALS_ID?.trim() ?: '',
                            params.BRANCH?.trim() ?: 'main'
                        )

                        env.APP_COMMIT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                        if (!env.IMAGE_TAG?.trim()) {
                            env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.APP_COMMIT_SHA}"
                        }
                        env.IMAGE_FULL = "${env.IMAGE_REPOSITORY}:${env.IMAGE_TAG}"

                        echo "Resolved branch : ${env.RESOLVED_APP_BRANCH}"
                        echo "Resolved image  : ${env.IMAGE_FULL}"
                    }
                }
                stash name: 'user-app-src', includes: 'user-app/**'
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Detect framework') {
            when {
                expression { return !params.ROLLBACK_MODE }
            }
            steps {
                dir('user-app') {
                    script {
                        String scriptsDir = sh(
                            script: '''
                                set -e
                                for d in "$WORKSPACE/platform-infra/jenkins/scripts" "$WORKSPACE/plateform-infra/jenkins/scripts"; do
                                    if [ -f "$d/detect-framework.sh" ]; then echo "$d"; exit 0; fi
                                done
                                echo "ERROR: detect-framework.sh not found." >&2; exit 1
                            ''',
                            returnStdout: true
                        ).trim()

                        env.FRAMEWORK = sh(
                            script: "bash '${scriptsDir}/detect-framework.sh'",
                            returnStdout: true
                        ).trim()

                        echo "Detected framework: ${env.FRAMEWORK}"
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('Detect Java runtime') {
            when {
                expression { return !params.ROLLBACK_MODE && params.ENABLE_SONARQUBE_SCAN }
            }
            steps {
                dir('user-app') {
                    script {
                        String scriptsDir = sh(
                            script: '''
                                set -e
                                for d in "$WORKSPACE/platform-infra/jenkins/scripts" "$WORKSPACE/plateform-infra/jenkins/scripts"; do
                                    if [ -f "$d/detect-java-version.sh" ]; then echo "$d"; exit 0; fi
                                done
                                exit 0
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!scriptsDir) {
                            env.JAVA_TOOLCHAIN_VERSION = ''
                            echo 'Java version detection script not found — using node default Java runtime.'
                            return
                        }

                        env.JAVA_TOOLCHAIN_VERSION = sh(
                            script: "bash '${scriptsDir}/detect-java-version.sh'",
                            returnStdout: true
                        ).trim()

                        echo env.JAVA_TOOLCHAIN_VERSION
                            ? "Detected Java runtime requirement: ${env.JAVA_TOOLCHAIN_VERSION}"
                            : 'No explicit Java runtime requirement — using node default.'
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('SonarQube Analysis') {
            when {
                expression { return !params.ROLLBACK_MODE && params.ENABLE_SONARQUBE_SCAN }
            }
            steps {
                dir('user-app') {
                    script {
                        def sonarWork = {
                            a8sSonarScan(
                                server       : params.SONARQUBE_SERVER_NAME?.trim() ?: 'sonarqube',
                                scannerTool  : params.SONARQUBE_SCANNER_TOOL?.trim(),
                                projectKey   : "${env.SAFE_WORKSPACE_ID}-${env.SAFE_PROJECT_NAME}",
                                projectName  : env.EFFECTIVE_PROJECT_NAME,
                                projectVersion: env.APP_COMMIT_SHA,
                                sources      : '.',
                                exclusions   : '**/node_modules/**,**/.next/**,**/dist/**,**/build/**,**/target/**,**/vendor/**,**/.git/**'
                            )
                        }

                        if (env.JAVA_TOOLCHAIN_VERSION?.trim()) {
                            def jdkPrefix = params.SONARQUBE_JDK_TOOL_PREFIX?.trim() ?: 'jdk'
                            def toolName  = "${jdkPrefix}${env.JAVA_TOOLCHAIN_VERSION.trim()}"
                            def javaHome
                            try {
                                javaHome = tool name: toolName, type: 'hudson.model.JDK'
                            } catch (Exception ex) {
                                error("Java ${env.JAVA_TOOLCHAIN_VERSION} required for SonarQube but JDK tool '${toolName}' is not configured on this node.")
                            }
                            withEnv([
                                "JAVA_HOME=${javaHome}",
                                "PATH=${javaHome}/bin:${env.PATH}",
                                "ORG_GRADLE_JAVA_HOME=${javaHome}",
                                "ORG_GRADLE_JAVA_INSTALLATIONS_PATHS=${javaHome}"
                            ]) {
                                sh 'java -version; command -v javac >/dev/null 2>&1 && javac -version || true'
                                sonarWork()
                            }
                        } else {
                            sonarWork()
                        }
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        stage('SonarQube Quality Gate') {
            when {
                expression {
                    return !params.ROLLBACK_MODE &&
                        params.ENABLE_SONARQUBE_SCAN &&
                        params.ENABLE_SONARQUBE_QUALITY_GATE
                }
            }
            steps {
                a8sSonarQualityGate(timeoutMinutes: 5, abortPipeline: true)
            }
        }

        // ──────────────────────────────────────────────────────────────────────
        // Build, scan, and push all happen on the same istad agent so the image
        // stays in the local Docker daemon — no docker save / stash / docker load
        // round-trip needed.
        stage('Build → Scan → Push') {
            when {
                expression { return !params.ROLLBACK_MODE }
            }
            steps {
                script {
                    // Fresh workspace: clear any leftovers from a previous run of
                    // this job on the same persistent workspace directory.
                    dir('platform-infra') { deleteDir() }
                    dir('user-app')       { deleteDir() }

                    unstash 'platform-infra-src'
                    unstash 'user-app-src'
                    // ── Generate / Detect Dockerfile ───────────────────────────────────
                    dir('user-app') {
                        sh '''
                            set -e

                            SCRIPTS_DIR=""
                            for d in "$WORKSPACE/platform-infra/jenkins/scripts" "$WORKSPACE/plateform-infra/jenkins/scripts"; do
                                if [ -f "$d/generate-dockerfile.sh" ]; then
                                    SCRIPTS_DIR="$d"
                                    break
                                fi
                            done

                            if [ -z "$SCRIPTS_DIR" ]; then
                                echo "ERROR: generate-dockerfile.sh not found."
                                ls -la "$WORKSPACE" || true
                                exit 1
                            fi

                            # Detect Dockerfile in repo root, case-insensitive
                            DOCKERFILE_PATH=$(find . -maxdepth 1 -iname "Dockerfile" -type f | head -1)

                            if [ -n "$DOCKERFILE_PATH" ]; then
                                echo "[dockerfile] Using user-provided Dockerfile: $DOCKERFILE_PATH"

                                # Normalize name to Dockerfile if user used dockerfile/DockerFile
                                if [ "$DOCKERFILE_PATH" != "./Dockerfile" ]; then
                                    cp "$DOCKERFILE_PATH" ./Dockerfile
                                    echo "[dockerfile] Normalized $DOCKERFILE_PATH to ./Dockerfile"
                                fi
                            else
                                echo "[dockerfile] No Dockerfile found in repo root."
                                echo "[dockerfile] Generating from platform template for ${FRAMEWORK}."

                                bash "${SCRIPTS_DIR}/generate-dockerfile.sh" "${FRAMEWORK}" "${SCRIPTS_DIR}"

                                if [ ! -f Dockerfile ]; then
                                    echo "ERROR: Dockerfile generation failed."
                                    exit 1
                                fi

                                echo "[dockerfile] Generated Dockerfile successfully."
                            fi

                            echo "[dockerfile] Final Dockerfile:"
                            ls -la Dockerfile
                        '''
                    }

                    // ── Registry login (once) ─────────────────────────────────
                    withCredentials([usernamePassword(
                        credentialsId: 'registry-credentials',
                        usernameVariable: 'REGISTRY_USERNAME',
                        passwordVariable: 'REGISTRY_PASSWORD'
                    )]) {
                        sh '''
                            echo "[auth] Logging in to ${REGISTRY_LOGIN_SERVER}"
                            echo "${REGISTRY_PASSWORD}" | docker login "${REGISTRY_LOGIN_SERVER}" \
                                -u "${REGISTRY_USERNAME}" --password-stdin
                        '''

                        // ── Build ─────────────────────────────────────────────
                        dir('user-app') {
                            sh '''
                                CACHE_FROM_ARG=""
                                CACHE_POLICY_ARG="--no-cache"

                                echo "[cache] Attempting to pull ${IMAGE_CACHE_REF}"
                                if docker pull "${IMAGE_CACHE_REF}" > /dev/null 2>&1; then
                                    CACHE_FROM_ARG="--cache-from ${IMAGE_CACHE_REF}"
                                    CACHE_POLICY_ARG=""
                                    echo "[cache] Cache hit — layers will be reused"
                                else
                                    echo "[cache] No cache image — building from scratch"
                                fi

                                echo "[build] Building ${IMAGE_FULL}"
                                docker build \
                                    ${CACHE_POLICY_ARG} \
                                    ${CACHE_FROM_ARG} \
                                    --build-arg BUILDKIT_INLINE_CACHE=1 \
                                    -t "${IMAGE_FULL}" \
                                    -t "${IMAGE_CACHE_REF}" \
                                    .
                                echo "[build] Docker build completed"
                            '''
                        }

                        // ── Scan ──────────────────────────────────────────────
                        script {
                            if (params.ENABLE_TRIVY_SCAN) {
                                def trivyPath = "${env.WORKSPACE}/trivy/docker-compose.yml"
                                def reportPath = "${env.WORKSPACE}/trivy/reports/trivy-report.json"

                                sh """
                                    mkdir -p "${env.WORKSPACE}/trivy/reports"
                                """

                                echo "[scan] Starting Trivy scan for ${env.IMAGE_FULL}"

                                def findingCount = trivyScan(
                                    fullImage   : env.IMAGE_FULL,
                                    trivyPath   : trivyPath,
                                    reportPath  : reportPath,
                                    gateSeverity: 'HIGH,CRITICAL'
                                )

                                echo "[scan] ${findingCount} HIGH/CRITICAL finding(s)"

                                echo "[scan] Uploading report to DefectDojo"

                                uploadDefectDojo(
                                    defectdojoUrl         : 'https://defetchdojo.anajak-khmer.site',
                                    defectdojoCredentialId: 'DEFECTDOJO',
                                    reportPath            : reportPath,
                                    productTypeName       : 'Web Applications',
                                    productName           : env.EFFECTIVE_PROJECT_NAME,
                                    engagementName        : "Jenkins-${env.BUILD_NUMBER}",
                                    testTitle             : "Trivy Image Scan - ${env.IMAGE_TAG}"
                                )

                                echo "[scan] DefectDojo upload completed"

                                securityGate(severity: 'CRITICAL')
                            } else {
                                echo '[scan] ENABLE_TRIVY_SCAN=false — skipping.'
                            }
                        }

                        // ── Push ──────────────────────────────────────────────
                        sh '''
                            echo "[push] Pushing versioned image ${IMAGE_FULL}"
                            docker push "${IMAGE_FULL}"

                            echo "[push] Pushing cache tag ${IMAGE_CACHE_REF}"
                            docker push "${IMAGE_CACHE_REF}"

                            echo "[push] Done"
                        '''
                    }
                }
            }
            post {
                always {
                    sh '''
                        docker rmi "${IMAGE_FULL}" "${IMAGE_CACHE_REF}" || true
                        docker image prune -f || true
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "Build succeeded for ${env.EFFECTIVE_PROJECT_NAME} — image: ${env.IMAGE_FULL}"
        }
        failure {
            echo "Build failed for ${env.EFFECTIVE_PROJECT_NAME}. Check stage logs."
        }
        always {
            script {
                echo 'Workspace kept on disk for Git and build-cache reuse.'
            }
        }
    }
}

// ─── Helper functions ─────────────────────────────────────────────────────────

def buildRepoBranchCandidates(String requestedBranch) {
    def normalized = requestedBranch?.toString()?.trim()
    if (!normalized) {
        return ['main', 'master']
    }
    if (normalized.startsWith('refs/tags/')) {
        return [normalized]
    }
    def candidates = [normalized]
    if (normalized == 'main')        { candidates << 'master' }
    else if (normalized == 'master') { candidates << 'main' }
    return candidates.unique()
}

def checkoutRepoWithBranchFallback(String repoUrl, String credentialsId, String requestedBranch) {
    def candidates = buildRepoBranchCandidates(requestedBranch)
    def lastError  = null

    sh '''
        if [ -d .git ]; then
            git -C . clean -fdx || true
            git -C . reset --hard || true
        fi
        rm -rf .gradle-home .gradle .m2 target build dist node_modules || true
    '''

    for (String candidate : candidates) {
        try {
            if (candidate.startsWith('refs/tags/')) {
                def tagName = candidate.substring('refs/tags/'.length())
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/tags/${tagName}"]],
                    userRemoteConfigs: [[
                        url: repoUrl,
                        credentialsId: credentialsId?.trim() ?: null,
                        refspec: "+refs/tags/${tagName}:refs/tags/${tagName}"
                    ]],
                    extensions: [
                        [$class: 'CloneOption',   shallow: true, depth: 1, noTags: false, honorRefspec: true, timeout: 60],
                        [$class: 'CheckoutOption', timeout: 60],
                        [$class: 'CleanBeforeCheckout', deleteUntrackedNestedRepositories: true]
                    ]
                ])
                return candidate
            }

            checkout([
                $class: 'GitSCM',
                branches: [[name: "*/${candidate}"]],
                userRemoteConfigs: [[
                    url: repoUrl,
                    credentialsId: credentialsId?.trim() ?: null
                ]],
                extensions: [
                    [$class: 'CloneOption',   shallow: true, depth: 1, noTags: true, honorRefspec: true, timeout: 60],
                    [$class: 'CheckoutOption', timeout: 60],
                    [$class: 'CleanBeforeCheckout', deleteUntrackedNestedRepositories: true]
                ]
            ])
            return candidate

        } catch (Exception err) {
            lastError = err
            echo "Checkout failed for branch '${candidate}' from ${repoUrl}: ${err.getMessage()}"
            if (!isBranchResolutionFailure(err)) {
                throw err
            }
            sh 'rm -rf .git .gradle-home .gradle || true'
        }
    }

    throw lastError ?: new RuntimeException("Could not checkout ${repoUrl}")
}

def isBranchResolutionFailure(Exception err) {
    def message = err?.getMessage() ?: ''
    def isResolutionFailure = message.contains("Couldn't find any revision to build") ||
        message.contains("Couldn't find remote ref") ||
        message.contains("Couldn't find branch") ||
        message.contains("Couldn't find any commit") ||
        message.contains("Couldn't resolve")
    return isResolutionFailure
}